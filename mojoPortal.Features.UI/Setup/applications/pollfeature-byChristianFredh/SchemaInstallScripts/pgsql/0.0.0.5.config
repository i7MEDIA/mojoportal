SET check_function_bodies = false;

CREATE TABLE public.mp_pollmodules (
    pollguid character varying(36) NOT NULL,
    moduleid integer NOT NULL
);

CREATE TABLE public.mp_polloptions (
    optionguid character varying(36) NOT NULL,
    pollguid character varying(36) NOT NULL,
    answer character varying(255) NOT NULL,
    votes integer NOT NULL,
    "order" integer NOT NULL
);

CREATE TABLE public.mp_polls (
    pollguid character varying(36) NOT NULL,
    siteguid character varying(36) NOT NULL,
    question character varying(255) NOT NULL,
    active boolean NOT NULL,
    anonymousvoting boolean NOT NULL,
    allowviewingresultsbeforevoting boolean NOT NULL,
    showordernumbers boolean NOT NULL,
    showresultswhendeactivated boolean NOT NULL,
    activefrom timestamp without time zone NOT NULL,
    activeto timestamp without time zone NOT NULL
);

CREATE TABLE public.mp_pollusers (
    pollguid character varying(36) NOT NULL,
    userguid character varying(36) NOT NULL,
    optionguid character varying(36) NOT NULL
);

ALTER TABLE ONLY public.mp_pollmodules
    ADD CONSTRAINT pk_pollmodules PRIMARY KEY (pollguid, moduleid);

ALTER TABLE ONLY public.mp_polloptions
    ADD CONSTRAINT pk_polloptions PRIMARY KEY (optionguid);

ALTER TABLE ONLY public.mp_polls
    ADD CONSTRAINT pk_polls PRIMARY KEY (pollguid);

ALTER TABLE ONLY public.mp_pollusers
    ADD CONSTRAINT pk_pollusers PRIMARY KEY (pollguid, userguid);

CREATE UNIQUE INDEX mp_pollmodules_pkey ON public.mp_pollmodules USING btree (pollguid, moduleid);

CREATE UNIQUE INDEX mp_polloptions_pkey ON public.mp_polloptions USING btree (optionguid);

CREATE UNIQUE INDEX mp_polls_pkey ON public.mp_polls USING btree (pollguid);

CREATE UNIQUE INDEX mp_pollusers_pkey ON public.mp_pollusers USING btree (pollguid, userguid);

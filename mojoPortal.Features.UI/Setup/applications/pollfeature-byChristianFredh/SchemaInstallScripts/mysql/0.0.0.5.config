SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_PollModules` (
  `PollGuid` varchar(36) NOT NULL,
  `ModuleID` int NOT NULL,
  PRIMARY KEY (`PollGuid`,`ModuleID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_PollOptions` (
  `OptionGuid` varchar(36) NOT NULL,
  `PollGuid` varchar(36) NOT NULL,
  `Answer` varchar(255) NOT NULL,
  `Votes` int NOT NULL,
  `Order` int NOT NULL,
  PRIMARY KEY (`OptionGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_PollUsers` (
  `PollGuid` varchar(36) NOT NULL,
  `UserGuid` varchar(36) NOT NULL,
  `OptionGuid` varchar(36) NOT NULL,
  PRIMARY KEY (`PollGuid`,`UserGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_Polls` (
  `PollGuid` varchar(36) NOT NULL,
  `SiteGuid` varchar(36) NOT NULL,
  `Question` varchar(255) NOT NULL,
  `Active` tinyint unsigned NOT NULL,
  `AnonymousVoting` tinyint unsigned NOT NULL,
  `AllowViewingResultsBeforeVoting` tinyint unsigned NOT NULL,
  `ShowOrderNumbers` tinyint unsigned NOT NULL,
  `ShowResultsWhenDeactivated` tinyint unsigned NOT NULL,
  `ActiveFrom` datetime NOT NULL,
  `ActiveTo` datetime NOT NULL,
  PRIMARY KEY (`PollGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

SET FOREIGN_KEY_CHECKS = 1;

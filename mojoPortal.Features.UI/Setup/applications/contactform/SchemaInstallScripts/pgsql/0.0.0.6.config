SET check_function_bodies = false;

CREATE TABLE public.mp_contactformmessage (
    rowguid character(36) NOT NULL,
    siteguid character(36) NOT NULL,
    moduleguid character(36) NOT NULL,
    email character varying(100) NOT NULL,
    url character varying(255) NOT NULL,
    subject character varying(255) NOT NULL,
    message text NOT NULL,
    createdutc timestamp without time zone NOT NULL,
    createdfromipaddress character varying(255) NOT NULL,
    userguid character(36) NOT NULL
);

ALTER TABLE ONLY public.mp_contactformmessage
    ADD CONSTRAINT pk_contactformmessage PRIMARY KEY (rowguid);

CREATE UNIQUE INDEX mp_contactformmessage_pkey ON public.mp_contactformmessage USING btree (rowguid);

CREATE OR REPLACE FUNCTION public.mp_contactformmessage_count(character)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  	cast(count(*) as int4)
from		mp_contactformmessage
where		moduleguid = $1
; $function$
;
CREATE OR REPLACE FUNCTION public.mp_contactformmessage_selectpage(character, integer, integer)
 RETURNS SETOF mp_contactformmessage
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_contactformmessage%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select  *

	from mp_contactformmessage
	where moduleguid = _moduleguid
	order by createdutc desc
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

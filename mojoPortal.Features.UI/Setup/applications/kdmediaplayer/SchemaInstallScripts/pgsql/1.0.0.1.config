SET check_function_bodies = false;

CREATE SEQUENCE public.mp_mediafileid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_mediaplayerid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_mediatrackid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;

CREATE TABLE public.mp_mediafile (
    fileid integer DEFAULT nextval(('"mp_mediafileid_seq"'::text)::regclass) NOT NULL,
    trackid integer NOT NULL,
    filepath character varying(255) NOT NULL,
    addeddate timestamp without time zone NOT NULL,
    userguid character(36)
);

CREATE TABLE public.mp_mediaplayer (
    playerid integer DEFAULT nextval(('"mp_mediaplayerid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    playertype character varying(10) NOT NULL,
    skin character varying(50) NOT NULL,
    createddate timestamp without time zone NOT NULL,
    userguid character(36),
    moduleguid character(36)
);

CREATE TABLE public.mp_mediatrack (
    trackid integer DEFAULT nextval(('"mp_mediatrackid_seq"'::text)::regclass) NOT NULL,
    playerid integer NOT NULL,
    tracktype character varying(10) NOT NULL,
    trackorder integer NOT NULL,
    name character varying(100) NOT NULL,
    artist character varying(100),
    createddate timestamp without time zone NOT NULL,
    userguid character(36)
);

ALTER TABLE ONLY public.mp_mediafile
    ADD CONSTRAINT pk_mediafile PRIMARY KEY (fileid);

ALTER TABLE ONLY public.mp_mediaplayer
    ADD CONSTRAINT pk_mediaplayer PRIMARY KEY (playerid);

ALTER TABLE ONLY public.mp_mediatrack
    ADD CONSTRAINT pk_mediatrack PRIMARY KEY (trackid);

CREATE UNIQUE INDEX mp_mediafile_pkey ON public.mp_mediafile USING btree (fileid);

CREATE UNIQUE INDEX mp_mediaplayer_pkey ON public.mp_mediaplayer USING btree (playerid);

CREATE UNIQUE INDEX mp_mediatrack_pkey ON public.mp_mediatrack USING btree (trackid);

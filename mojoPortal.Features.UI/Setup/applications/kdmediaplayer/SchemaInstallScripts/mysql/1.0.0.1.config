SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_MediaFile` (
  `FileID` int NOT NULL AUTO_INCREMENT,
  `TrackID` int NOT NULL,
  `FilePath` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `AddedDate` datetime NOT NULL,
  `UserGuid` varchar(36) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  PRIMARY KEY (`FileID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE `mp_MediaPlayer` (
  `PlayerID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL,
  `PlayerType` varchar(10) COLLATE utf8mb4_unicode_ci NOT NULL,
  `Skin` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL,
  `CreatedDate` datetime NOT NULL,
  `UserGuid` varchar(36) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `ModuleGuid` varchar(36) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  PRIMARY KEY (`PlayerID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE `mp_MediaTrack` (
  `TrackID` int NOT NULL AUTO_INCREMENT,
  `PlayerID` int NOT NULL,
  `TrackType` varchar(10) COLLATE utf8mb4_unicode_ci NOT NULL,
  `TrackOrder` int NOT NULL,
  `Name` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL,
  `Artist` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `CreatedDate` datetime NOT NULL,
  `UserGuid` varchar(36) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  PRIMARY KEY (`TrackID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

SET FOREIGN_KEY_CHECKS = 1;

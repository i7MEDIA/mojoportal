	createddate,
	title,
	excerpt,
	description,
	startdate,
	isinnewsletter,
	includeinfeed,
	allowcommentsfordays,
	location,
	userguid,
	lastmoduserguid,
	lastmodutc,
	blogguid,
	moduleguid,
	itemurl
)
values
(
    _moduleid,
    _username,
    _createddate,
    _title,
    _excerpt,
    _description,
    _startdate,
    _isinnewsletter,
    _includeinfeed,
    _allowcommentsfordays,
    _location,
    _userguid,
    _userguid,
    _createddate,
    _blogguid,
    _moduleguid,
    _itemurl
);

select into _itemid cast(currval('mp_blogs_itemid_seq') as int4);
select into t_found 1 from mp_blogstats where moduleid = _moduleid limit 1;
if found then
		update mp_blogstats
		set 	entrycount = entrycount + 1
		where moduleid = _moduleid;
else
		insert into mp_blogstats(moduleguid, moduleid, entrycount)
		values (_moduleguid,_moduleid, 1);   
end if;
return _itemid;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_select(integer, timestamp without time zone)
 RETURNS SETOF mp_blog_select_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_begindate alias for $2;
	 _rowstoget int;
	_rec mp_blog_select_type%ROWTYPE;

begin

_rowstoget := coalesce((select settingvalue::text::int4 from mp_modulesettings 
	where settingname = 'BlogEntriesToShowSetting' 
	and moduleid = _moduleid limit 1),1);
for _rec in
	select		
		itemid,
		moduleid,
		createdbyuser,
		createddate,
		title,
		excerpt,
		startdate,
		isinnewsletter,
		description,
		to_char(commentcount, '99999999999') as commentcount,
		trackbackcount,
		includeinfeed,
		allowcommentsfordays,
		blogguid,
		moduleguid,
		location,
		userguid,
		lastmoduserguid,
        	lastmodutc,
        	itemurl
		
	from        mp_blogs
	where
	    (moduleid = _moduleid) and (_begindate >= startdate)
	   order by
		startdate desc
	limit _rowstoget
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectarchivebymonth(integer, timestamp without time zone)
 RETURNS SETOF mp_blog_selectarchivebymonth_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		cast(date_part('month', startdate) as int4) as month, 
		monthname(startdate) as monthname,
		cast(date_part('year', startdate) as int4) as year, 
		1 as day, 
		cast(count(*) as int4) as count 
from 		mp_blogs
 
where 	moduleid = $1 and ispublished = true and startdate < $2
group by 	date_part('year', startdate), 
		date_part('month', startdate),
		monthname(startdate)
order by 	year desc, month desc; $function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectbycategory(integer, integer)
 RETURNS SETOF mp_blog_selectbycategory_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select	
        b.itemid ,
        b.moduleid ,
        b.createdbyuser ,
        b.createddate ,
        b.title , 
        b.excerpt , 
        b.description , 
        b.startdate , 
        b.isinnewsletter ,
        b.includeinfeed ,
        b.commentcount,
        b.itemurl

from	mp_blogs b

inner join    mp_blogitemcategories bic
on            b.itemid = bic.itemid

where     b.moduleid = $1 and bic.categoryid = $2

order by b.startdate desc ;$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectbyenddate(integer, date)
 RETURNS SETOF mp_blog_select_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_enddate alias for $2;
	 _rowstoget int;
	_rec mp_blog_select_type%ROWTYPE;

begin

_rowstoget := coalesce((select settingvalue::text::int4 from mp_modulesettings 
	where settingname = 'BlogEntriesToShowSetting' 
	and moduleid = _moduleid limit 1),1);
for _rec in
	select		
		itemid,
		moduleid,
		createdbyuser,
		createddate,
		title,
		excerpt,
		startdate,
		isinnewsletter,
		description,
		to_char(commentcount, '99999999999') as commentcount,
		trackbackcount,
		includeinfeed,
		allowcommentsfordays,
		blogguid,
		moduleguid,
		location,
		userguid,
		lastmoduserguid,
        	lastmodutc,
        	itemurl
	from        mp_blogs
	where
	    (moduleid = _moduleid) and (startdate <= _enddate)
	   order by
		itemid desc,  startdate desc
	limit _rowstoget
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectbymonth(integer, integer, integer)
 RETURNS SETOF mp_blogs
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select	*
from 		mp_blogs
where 	moduleid = $3
		and date_part('year', startdate)  = $2 
		and date_part('month', startdate)  = $1
order by	 startdate desc; $function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectbypage(integer, integer)
 RETURNS SETOF mp_blog_selectbypage_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select
		gi.itemid,
		gi.moduleid,
		gi.commentcount,
		gi.title, 
		gi.itemurl, 
		gi.description, 
		m.moduletitle,
		md.featurename
		
from
		mp_blogs gi
		
JOIN		mp_modules m
ON		gi.moduleid = m.moduleid

JOIN		mp_moduledefinitions md
ON		m.moduledefid = md.moduledefid

JOIN		mp_pagemodules pm
ON		pm.moduleid = m.moduleid

JOIN		mp_pages p
ON		p.pageid = pm.pageid
		
where
		p.siteid = $1
		AND pm.pageid = $2
		
		; $function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectdrafts(integer, timestamp without time zone)
 RETURNS SETOF mp_blog_select_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_begindate alias for $2;
	_rec mp_blog_select_type%ROWTYPE;

begin


for _rec in
	select		
		itemid,
		moduleid,
		createdbyuser,
		createddate,
		title,
		excerpt,
		startdate,
		isinnewsletter,
		description,
		to_char(commentcount, '99999999999') as commentcount,
		trackbackcount,
		includeinfeed,
		allowcommentsfordays,
		blogguid,
		moduleguid,
		location,
		userguid,
		lastmoduserguid,
        	lastmodutc
		
	from        mp_blogs
	where
	    (moduleid = _moduleid) and (startdate > _begindate)
	   order by
		startdate desc
	
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_selectone2(integer)
 RETURNS SETOF mp_blogs
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select		*
			
from	mp_blogs
where   (itemid = $1); $function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_update(integer, integer, character varying, character varying, character varying, text, timestamp without time zone, boolean, boolean, character varying, integer, text, character, timestamp without time zone)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_itemid alias for $1;
	_moduleid alias for $2;
	_username alias for $3;
	_title alias for $4;
	_excerpt alias for $5;
	_description alias for $6;
	_startdate alias for $7;
	_isinnewsletter alias for $8;
	_includeinfeed alias for $9;
	_itemurl alias for $10;
	_allowcommentsfordays alias for $11;
	_location alias for $12;
	_lastmoduserguid alias for $13;
	_lastmodutc alias for $14;
	_rowcount int4;
begin

update mp_blogs
set 
moduleid = _moduleid,
createdbyuser = _username,
createddate = current_timestamp(3),
title = _title,
excerpt = _excerpt,
description = _description,
startdate = _startdate,
isinnewsletter = _isinnewsletter,
includeinfeed = _includeinfeed,
itemurl = _itemurl,
allowcommentsfordays = _allowcommentsfordays,
location = _location,
lastmoduserguid = _lastmoduserguid,
lastmodutc = _lastmodutc


where 
itemid = _itemid; 
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_categoryid alias for $1;
	_rowcount int4;
begin


	delete from mp_blogcategories
	where categoryid = _categoryid;
	
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_insert(integer, character varying)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

insert into 	mp_blogcategories
(				
                moduleid,
                category
) 
values 
(				
                $1, --:moduleid
                $2 --:category
);

select cast(currval('mp_blogcategories_categoryid_seq') as int4);$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_select_bymodule(integer, timestamp without time zone)
 RETURNS SETOF mp_blogcategories_select_bymodule_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        bc.categoryid,
        bc.moduleid,
        bc.category,
        count(bic.itemid) as postcount
from
        mp_blogcategories bc
        
join    mp_blogitemcategories bic
on      bc.categoryid = bic.categoryid

join	mp_blogs b
on	b.itemid = bic.itemid
        

where   bc.moduleid = $1 and b.startdate < $2
	

group by bc.categoryid, bc.moduleid, bc.category

order by bc.category;$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_select_one(integer)
 RETURNS SETOF mp_blogcategories_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        categoryid,
        moduleid,
        category
from
        mp_blogcategories
        
where
        categoryid = $1;$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_selectlist_bymodule(integer)
 RETURNS SETOF mp_blogcategories_select_bymodule_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        bc.categoryid,
        bc.moduleid,
        bc.category,
        count(bic.itemid) as postcount
from
        mp_blogcategories bc
        
left outer join    mp_blogitemcategories bic
on      bc.categoryid = bic.categoryid
        

where   bc.moduleid = $1 
	

group by bc.categoryid, bc.moduleid, bc.category

order by bc.category;$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcategories_update(integer, character varying)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_categoryid alias for $1;
	_category alias for $2;
	_rowcount int4;
begin

update 		mp_blogcategories

set
            category = _category --:category
            
where
            categoryid = _categoryid; --:categoryid

GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcomment_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_blogcommentid alias for $1;
	 _moduleid int;
	 _itemid int;
	_rowcount int;
begin

select into _moduleid, _itemid 
            moduleid, itemid
from	mp_blogcomments
where blogcommentid = _blogcommentid;

delete 
from 	mp_blogcomments
where	blogcommentid = _blogcommentid;

GET DIAGNOSTICS _rowcount = ROW_COUNT;

update mp_blogs
set commentcount = commentcount - 1
where moduleid = _moduleid and itemid = _itemid;

update mp_blogstats
set 	commentcount = commentcount - 1
where moduleid = _moduleid;   

return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcomment_insert(integer, integer, character varying, character varying, character varying, text, timestamp without time zone)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_itemid alias for $2;
	_name alias for $3;
	_title alias for $4;
	_url alias for $5;
	_comment alias for $6;
	_datecreated alias for $7;
	_rowcount int4;
begin

insert into mp_blogcomments
(
    	moduleid,
	itemid,
    	name,
    	title,
	url,
    	comment,
	datecreated
)
values
(
    _moduleid,
    _itemid,
    _name,
    _title,
    _url,
    _comment,
    _datecreated
);

update mp_blogs
set commentcount = commentcount + 1
where moduleid = _moduleid and itemid = _itemid;

update mp_blogstats
set 	commentcount = commentcount + 1
where moduleid = _moduleid; 
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogcomments_select(integer, integer)
 RETURNS SETOF mp_blogcomments_select_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select		
	blogcommentid,
	itemid, 
	moduleid, 
	name, 
	title, 
	url, 
	comment, 
	datecreated
from        mp_blogcomments
where
    		moduleid = $1
		and itemid = $2
   order by
   	blogcommentid,  datecreated desc; $function$
;
CREATE OR REPLACE FUNCTION public.mp_blogitemcategories_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_itemid alias for $1;
	_rowcount int4;
begin


	delete from mp_blogitemcategories
	where itemid = _itemid;
	
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogitemcategories_insert(integer, integer)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

insert into 	mp_blogitemcategories
(				
                itemid,
                categoryid
) 
values 
(				
                $1, --:itemid
                $2 --:categoryid
);

select cast(currval('mp_blogitemcategories_id_seq') as int4);$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogitemcategories_select_byitem(integer)
 RETURNS SETOF mp_blogitemcategories_select_byitem_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        bc.categoryid,
        bc.category
from
        mp_blogitemcategories bic
inner join mp_blogcategories bc
on         bic.categoryid = bc.categoryid
where   itemid = $1

order by bc.category;$function$
;
CREATE OR REPLACE FUNCTION public.mp_blogstats_select(integer)
 RETURNS SETOF mp_blogstats_select_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select		
			moduleid, 
			entrycount,
			commentcount
from       		 mp_blogstats
where
    			moduleid = $1; $function$
;

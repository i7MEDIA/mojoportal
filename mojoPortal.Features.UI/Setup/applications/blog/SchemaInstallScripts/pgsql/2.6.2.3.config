SET check_function_bodies = false;

CREATE SEQUENCE public.mp_blogcategories_categoryid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_blogcomments_blogcommentid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_blogitemcategories_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_blogs_itemid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;

CREATE TABLE public.mp_blogs (
    itemid integer DEFAULT nextval(('"mp_blogs_itemid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    createdbyuser character varying(100),
    createddate timestamp without time zone,
    title character varying(100),
    excerpt character varying(512),
    startdate timestamp without time zone,
    isinnewsletter boolean,
    includeinfeed boolean,
    description text,
    commentcount integer DEFAULT 0 NOT NULL,
    trackbackcount integer DEFAULT 0 NOT NULL,
    category character varying(50),
    allowcommentsfordays integer DEFAULT 0 NOT NULL,
    blogguid character varying(36),
    moduleguid character varying(36),
    location text,
    userguid character varying(36),
    lastmoduserguid character varying(36),
    lastmodutc timestamp without time zone,
    itemurl character varying(255),
    heading character varying(255),
    metakeywords character varying(255),
    metadescription character varying(255),
    abstract text,
    compiledmeta text,
    ispublished boolean,
    subtitle character varying(500),
    enddate timestamp without time zone,
    approved boolean DEFAULT true NOT NULL,
    approveddate timestamp without time zone,
    approvedby character(36),
    showauthorname boolean DEFAULT true NOT NULL,
    showauthoravatar boolean DEFAULT true NOT NULL,
    showauthorbio boolean DEFAULT true NOT NULL,
    includeinsearch boolean DEFAULT true NOT NULL,
    includeinsitemap boolean DEFAULT true NOT NULL,
    usebingmap boolean DEFAULT true NOT NULL,
    mapheight character varying(10) DEFAULT '300'::character varying NOT NULL,
    mapwidth character varying(10) DEFAULT '300'::character varying NOT NULL,
    showmapoptions boolean DEFAULT true NOT NULL,
    showzoomtool boolean DEFAULT true NOT NULL,
    showlocationinfo boolean DEFAULT false NOT NULL,
    usedrivingdirections boolean DEFAULT false NOT NULL,
    maptype character varying(20) DEFAULT 'G_SATELLITE_MAP'::character varying NOT NULL,
    mapzoom integer DEFAULT 13 NOT NULL,
    showdownloadlink boolean DEFAULT false NOT NULL,
    excludefromrecentcontent boolean DEFAULT false NOT NULL,
    includeinnews boolean DEFAULT false NOT NULL,
    pubname character varying(255),
    publanguage character varying(7),
    pubaccess character varying(20),
    pubgenres character varying(255),
    pubkeywords character varying(255),
    pubgeolocations character varying(255),
    pubstocktickers character varying(255),
    headlineimageurl character varying(255),
    includeimageinexcerpt boolean DEFAULT true NOT NULL,
    includeimageinpost boolean DEFAULT false NOT NULL
);

CREATE TABLE public.mp_blogcategories (
    categoryid integer DEFAULT nextval(('"mp_blogcategories_categoryid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    category character varying(255)
);

CREATE TABLE public.mp_blogcomments (
    blogcommentid integer DEFAULT nextval(('"mp_blogcomments_blogcommentid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    itemid integer NOT NULL,
    comment text NOT NULL,
    title character varying(100),
    name character varying(100),
    url character varying(200),
    datecreated timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL
);

CREATE TABLE public.mp_blogitemcategories (
    id integer DEFAULT nextval(('"mp_blogitemcategories_id_seq"'::text)::regclass) NOT NULL,
    itemid integer NOT NULL,
    categoryid integer NOT NULL
);

CREATE TABLE public.mp_blogstats (
    moduleid integer NOT NULL,
    entrycount integer DEFAULT 0 NOT NULL,
    commentcount integer DEFAULT 0 NOT NULL,
    trackbackcount integer DEFAULT 0 NOT NULL,
    moduleguid character varying(36)
);

ALTER TABLE ONLY public.mp_blogcategories
    ADD CONSTRAINT pk_blogcategories PRIMARY KEY (categoryid);

ALTER TABLE ONLY public.mp_blogcomments
    ADD CONSTRAINT pk_blogcomments PRIMARY KEY (blogcommentid);

ALTER TABLE ONLY public.mp_blogitemcategories
    ADD CONSTRAINT pk_blogitemcategories PRIMARY KEY (id);

ALTER TABLE ONLY public.mp_blogs
    ADD CONSTRAINT pk_blogs PRIMARY KEY (itemid);

CREATE INDEX ifk_blogcategories_moduleid ON public.mp_blogcategories USING btree (moduleid);

CREATE INDEX ifk_blogitemcategories_categoryid ON public.mp_blogitemcategories USING btree (categoryid);

CREATE INDEX ifk_blogitemcategories_itemid ON public.mp_blogitemcategories USING btree (itemid);

CREATE INDEX ifk_blogs_moduleid ON public.mp_blogs USING btree (moduleid);

CREATE INDEX ifk_blogstats_moduleid ON public.mp_blogstats USING btree (moduleid);

ALTER TABLE ONLY public.mp_blogcomments
    ADD CONSTRAINT fk_blogcomments_blogs FOREIGN KEY (itemid) REFERENCES public.mp_blogs(itemid);

ALTER TABLE ONLY public.mp_blogitemcategories
    ADD CONSTRAINT fk_blogitemcategories_blogs FOREIGN KEY (itemid) REFERENCES public.mp_blogs(itemid);

ALTER TABLE ONLY public.mp_blogitemcategories
    ADD CONSTRAINT fk_blogitemcategoriesblogcategories FOREIGN KEY (categoryid) REFERENCES public.mp_blogcategories(categoryid);

CREATE TYPE public.mp_blog_select_type AS (
	itemid integer,
	moduleid integer,
	createdbyuser character varying(100),
	createddate timestamp without time zone,
	title character varying(100),
	excerpt character varying(512),
	startdate timestamp without time zone,
	isinnewsletter boolean,
	description text,
	commentcount character varying(20),
	trackbackcount integer,
	includeinfeed boolean,
	allowcommentsfordays integer,
	blogguid character(36),
	moduleguid character(36),
	location text,
	userguid character(36),
	lastmoduserguid character(36),
	lastmodutc timestamp without time zone,
	itemurl character varying(255)
);
CREATE TYPE public.mp_blog_selectarchivebymonth_type AS (
	month integer,
	monthname character varying(10),
	year integer,
	day integer,
	count integer
);
CREATE TYPE public.mp_blog_selectbycategory_type AS (
	itemid integer,
	moduleid integer,
	createdbyuser character varying(100),
	createddate timestamp without time zone,
	title character varying(100),
	excerpt character varying(512),
	description text,
	startdate timestamp without time zone,
	isinnewsletter boolean,
	includeinfeed boolean,
	commentcount integer,
	itemurl character varying(255)
);
CREATE TYPE public.mp_blog_selectbypage_type AS (
	itemid integer,
	moduleid integer,
	commentcount integer,
	title character varying(255),
	itemurl character varying(255),
	description text,
	moduletitle character varying(255),
	featurename character varying(255)
);
CREATE TYPE public.mp_blogcategories_select_bymodule_type AS (
	categoryid integer,
	moduleid integer,
	category character varying(255),
	postcount bigint
);
CREATE TYPE public.mp_blogcategories_select_one_type AS (
	categoryid integer,
	moduleid integer,
	category character varying(255)
);
CREATE TYPE public.mp_blogcomments_select_type AS (
	blogcommentid integer,
	itemid integer,
	moduleid integer,
	name character varying(100),
	title character varying(100),
	url character varying(200),
	comment text,
	datecreated timestamp without time zone
);
CREATE TYPE public.mp_blogitemcategories_select_byitem_type AS (
	categoryid integer,
	category character varying(255)
);
CREATE TYPE public.mp_blogstats_select_type AS (
	moduleid integer,
	entrycount integer,
	commentcount integer
);

CREATE OR REPLACE FUNCTION public.mp_blog_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_itemid alias for $1;
	 _moduleid int;
	_rowcount int;
begin

select into _moduleid moduleid 
from mp_blogs where itemid = _itemid;

delete from 
    mp_blogs
where
    itemid = _itemid;
    
GET DIAGNOSTICS _rowcount = ROW_COUNT;

update mp_blogstats
set 	entrycount = entrycount - 1
where moduleid = _moduleid;   

return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_insert(integer, character varying, character varying, character varying, text, timestamp without time zone, boolean, boolean, character varying, integer, text, character, timestamp without time zone, character, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_username alias for $2;
	_title alias for $3;
	_excerpt alias for $4;
	_description alias for $5;
	_startdate alias for $6;
	_isinnewsletter alias for $7;
	_includeinfeed alias for $8;
	_category alias for $9;
	_allowcommentsfordays alias for $10;
	_location alias for $11;
	_userguid alias for $12;
	_createddate alias for $13;
	_blogguid alias for $14;
	_moduleguid alias for $15;
	_itemid int4;
	t_found int;
	
begin

insert into mp_blogs
(
	moduleid,
	createdbyuser,
	createddate,
	title,
	excerpt,
	description,
	startdate,
	isinnewsletter,
	includeinfeed,
	category,
	allowcommentsfordays,
	location,
	userguid,
	lastmoduserguid,
	lastmodutc,
	blogguid,
	moduleguid
)
values
(
    _moduleid,
    _username,
    _createddate,
    _title,
    _excerpt,
    _description,
    _startdate,
    _isinnewsletter,
    _includeinfeed,
    _category,
    _allowcommentsfordays,
    _location,
    _userguid,
    _userguid,
    _createddate,
    _blogguid,
    _moduleguid
);

select into _itemid cast(currval('mp_blogs_itemid_seq') as int4);
select into t_found 1 from mp_blogstats where moduleid = _moduleid limit 1;
if found then
		update mp_blogstats
		set 	entrycount = entrycount + 1
		where moduleid = _moduleid;
else
		insert into mp_blogstats(moduleguid, moduleid, entrycount)
		values (_moduleguid,_moduleid, 1);   
end if;
return _itemid;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_blog_insert(integer, character varying, character varying, character varying, text, timestamp without time zone, boolean, boolean, integer, text, character, timestamp without time zone, character, character, character varying)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_username alias for $2;
	_title alias for $3;
	_excerpt alias for $4;
	_description alias for $5;
	_startdate alias for $6;

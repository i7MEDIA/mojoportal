CREATE PROCEDURE [dbo].[mp_BlogComment_Delete]
(
    @BlogCommentID int
)
AS

DECLARE @ModuleID int
DECLARE @ItemID int

SELECT @ModuleID = ModuleID, @ItemID = ItemID
FROM	mp_BlogComments
WHERE BlogCommentID = @BlogCommentID

DELETE FROM
    mp_BlogComments

WHERE
    BlogCommentID = @BlogCommentID



UPDATE mp_Blogs
SET CommentCount = CommentCount - 1
WHERE ModuleID = @ModuleID AND ItemID = @ItemID

UPDATE mp_BlogStats
SET 	CommentCount = CommentCount - 1
WHERE ModuleID = @ModuleID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_BlogComment_Insert]

@ModuleID       int,
@ItemID	int,
@Name       nvarchar(100),
@Title          nvarchar(100),
@URL       nvarchar(200),
@Comment    nvarchar(max),
@DateCreated	datetime


AS
INSERT INTO mp_BlogComments

(

    ModuleID,
	ItemID,
    [Name],
    Title,
	URL,
    Comment,
	DateCreated

)

VALUES
(

    @ModuleID,
    @ItemID,
   @Name,
    @Title,
    @URL,
    @Comment,
    @DateCreated

)



UPDATE mp_Blogs
SET CommentCount = CommentCount + 1
WHERE ModuleID = @ModuleID AND ItemID = @ItemID


UPDATE mp_BlogStats
SET 	CommentCount = CommentCount + 1
WHERE ModuleID = @ModuleID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

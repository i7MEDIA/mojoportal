CREATE PROCEDURE [dbo].[mp_Blogs_GetCount]

/*
Author:   			
Created: 			2010-01-05
Last Modified: 		2012-11-10
*/

@ModuleID int,
@BeginDate datetime,
@CurrentTime datetime

AS

SELECT COUNT(*) 
FROM [dbo].[mp_Blogs]
WHERE
(ModuleID = @ModuleID)  
    			and (@BeginDate >= StartDate)
    			and IsPublished = 1
    			and StartDate <= @CurrentTime
    			AND (EndDate IS NULL OR EndDate > @CurrentTime)

CREATE PROCEDURE [dbo].[mp_BlogStats_UpdateEntryStats]

/*
Author:   			
Created: 			2014-04-18
Last Modified: 		2014-04-18

*/

@ModuleID int

AS

UPDATE [dbo].mp_BlogStats
SET EntryCount = (SELECT COUNT(*) FROM [dbo].mp_Blogs WHERE ModuleID = @ModuleID)
WHERE ModuleID = @ModuleID

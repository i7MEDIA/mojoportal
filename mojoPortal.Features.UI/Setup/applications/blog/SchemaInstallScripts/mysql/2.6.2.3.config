SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_BlogCategories` (
  `CategoryID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `Category` varchar(255) NOT NULL DEFAULT '',
  `PostCount` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`CategoryID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_BlogComments` (
  `BlogCommentID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `ItemID` int NOT NULL DEFAULT '0',
  `Comment` text NOT NULL,
  `Title` varchar(100) DEFAULT NULL,
  `Name` varchar(100) DEFAULT NULL,
  `URL` varchar(250) DEFAULT NULL,
  `DateCreated` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  PRIMARY KEY (`BlogCommentID`),
  KEY `FK_mp_BlogComments` (`ItemID`),
  CONSTRAINT `FK_mp_BlogComments` FOREIGN KEY (`ItemID`) REFERENCES `mp_Blogs` (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_BlogItemCategories` (
  `ID` int NOT NULL AUTO_INCREMENT,
  `ItemID` int NOT NULL DEFAULT '0',
  `CategoryID` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`ID`),
  KEY `FK_mp_BlogItemCatBlogCat` (`CategoryID`),
  KEY `FK_mp_BlogItemCategories` (`ItemID`),
  CONSTRAINT `FK_mp_BlogItemCatBlogCat` FOREIGN KEY (`CategoryID`) REFERENCES `mp_BlogCategories` (`CategoryID`),
  CONSTRAINT `FK_mp_BlogItemCategories` FOREIGN KEY (`ItemID`) REFERENCES `mp_Blogs` (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_BlogStats` (
  `ModuleID` int NOT NULL DEFAULT '0',
  `EntryCount` int NOT NULL DEFAULT '0',
  `CommentCount` int NOT NULL DEFAULT '0',
  `TrackBackCount` int NOT NULL DEFAULT '0',
  `ModuleGuid` varchar(36) DEFAULT NULL,
  PRIMARY KEY (`ModuleID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_Blogs` (
  `ItemID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `CreatedByUser` varchar(100) NOT NULL DEFAULT '',
  `CreatedDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `Title` varchar(100) DEFAULT NULL,
  `StartDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `IsInNewsletter` tinyint unsigned NOT NULL DEFAULT '0',
  `Description` longtext,
  `CommentCount` int NOT NULL DEFAULT '0',
  `TrackBackCount` int NOT NULL DEFAULT '0',
  `Category` varchar(50) DEFAULT NULL,
  `IncludeInFeed` tinyint unsigned DEFAULT '1',
  `AllowCommentsForDays` int DEFAULT '0',
  `BlogGuid` varchar(36) DEFAULT NULL,
  `ModuleGuid` varchar(36) DEFAULT NULL,
  `Location` text,
  `UserGuid` varchar(36) DEFAULT NULL,
  `LastModUserGuid` varchar(36) DEFAULT NULL,
  `LastModUtc` datetime DEFAULT NULL,
  `ItemUrl` varchar(255) DEFAULT NULL,
  `Heading` varchar(255) DEFAULT NULL,
  `MetaKeywords` varchar(255) DEFAULT NULL,
  `MetaDescription` varchar(255) DEFAULT NULL,
  `Abstract` text,
  `CompiledMeta` text,
  `IsPublished` int DEFAULT NULL,
  `SubTitle` varchar(500) DEFAULT NULL,
  `EndDate` datetime DEFAULT NULL,
  `Approved` tinyint unsigned NOT NULL DEFAULT '1',
  `ApprovedDate` datetime DEFAULT NULL,
  `ApprovedBy` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  `ShowAuthorName` tinyint unsigned NOT NULL DEFAULT '1',
  `ShowAuthorAvatar` tinyint unsigned NOT NULL DEFAULT '1',
  `ShowAuthorBio` tinyint unsigned NOT NULL DEFAULT '1',
  `IncludeInSearch` tinyint unsigned NOT NULL DEFAULT '1',
  `IncludeInSiteMap` tinyint unsigned NOT NULL DEFAULT '1',
  `UseBingMap` tinyint unsigned NOT NULL DEFAULT '0',
  `MapHeight` varchar(10) NOT NULL DEFAULT '300',
  `MapWidth` varchar(10) NOT NULL DEFAULT '500',
  `ShowMapOptions` tinyint unsigned NOT NULL DEFAULT '0',
  `ShowZoomTool` tinyint unsigned NOT NULL DEFAULT '0',
  `ShowLocationInfo` tinyint unsigned NOT NULL DEFAULT '0',
  `UseDrivingDirections` tinyint unsigned NOT NULL DEFAULT '0',
  `MapType` varchar(20) NOT NULL DEFAULT 'G_SATELLITE_MAP',
  `MapZoom` tinyint unsigned NOT NULL DEFAULT '13',
  `ShowDownloadLink` tinyint unsigned NOT NULL DEFAULT '0',
  `ExcludeFromRecentContent` int NOT NULL DEFAULT '0',
  `IncludeInNews` tinyint unsigned NOT NULL DEFAULT '0',
  `PubName` varchar(255) DEFAULT NULL,
  `PubLanguage` varchar(7) DEFAULT NULL,
  `PubAccess` varchar(20) DEFAULT NULL,
  `PubGenres` varchar(255) DEFAULT NULL,
  `PubKeyWords` varchar(255) DEFAULT NULL,
  `PubGeoLocations` varchar(255) DEFAULT NULL,
  `PubStockTickers` varchar(255) DEFAULT NULL,
  `HeadlineImageUrl` varchar(255) DEFAULT NULL,
  `IncludeImageInExcerpt` tinyint unsigned NOT NULL DEFAULT '1',
  `IncludeImageInPost` tinyint unsigned NOT NULL DEFAULT '0',
  PRIMARY KEY (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

SET FOREIGN_KEY_CHECKS = 1;

CREATE PROCEDURE [dbo].[mp_CalendarEvents_Insert]

@ItemGuid		uniqueidentifier,
@ModuleGuid		uniqueidentifier,
@ModuleID		int,
@Title			nvarchar(255),
@Description	nvarchar(max),
@ImageName		nvarchar(100),
@EventDate		datetime,
@StartTime		smalldatetime,
@EndTime		smalldatetime,
@UserID			int,
@UserGuid		uniqueidentifier,
@Location		nvarchar(max),
@RequiresTicket	bit,
@TicketPrice	decimal(15,4),
@CreatedDate	datetime,
@ShowMap		bit

	
AS

INSERT INTO 	[dbo].[mp_CalendarEvents] 
(
				ItemGuid,
				ModuleGuid,
				[ModuleID],
				[Title],
				[Description],
				[ImageName],
				[EventDate],
				[StartTime],
				[EndTime],
				[CreatedDate],
				[UserID],
				UserGuid,
				Location,
				RequiresTicket,
				TicketPrice,
				LastModUserGuid,
				LastModUtc,
				ShowMap
) 

VALUES 
(
				@ItemGuid,
				@ModuleGuid,
				@ModuleID,
				@Title,
				@Description,
				@ImageName,
				@EventDate,
				@StartTime,
				@EndTime,
				@CreatedDate,
				@UserID,
				@UserGuid,
				@Location,
				@RequiresTicket,
				@TicketPrice,
				@UserGuid,
				@CreatedDate,
				@ShowMap
				
)
SELECT @@IDENTITY
GO


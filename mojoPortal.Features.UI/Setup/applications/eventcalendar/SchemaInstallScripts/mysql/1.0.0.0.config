SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_CalendarEvents` (
  `ItemID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `Title` varchar(255) NOT NULL DEFAULT '',
  `Description` text,
  `ImageName` varchar(100) DEFAULT NULL,
  `EventDate` datetime DEFAULT NULL,
  `StartTime` datetime DEFAULT NULL,
  `EndTime` datetime DEFAULT NULL,
  `CreatedDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `UserID` int NOT NULL DEFAULT '0',
  `ItemGuid` varchar(36) DEFAULT NULL,
  `ModuleGuid` varchar(36) DEFAULT NULL,
  `UserGuid` varchar(36) DEFAULT NULL,
  `LastModUserGuid` varchar(36) DEFAULT NULL,
  `Location` text,
  `LastModUtc` datetime DEFAULT NULL,
  `RequiresTicket` tinyint unsigned DEFAULT '0',
  `TicketPrice` decimal(15,4) DEFAULT NULL,
  `ShowMap` tinyint unsigned DEFAULT '1',
  PRIMARY KEY (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

SET FOREIGN_KEY_CHECKS = 1;

				showmap
) 
values 
(				
                $1, --:moduleid
                $2, --:title
                $3, --:description
                $4, --:imagename
                $5, --:eventdate
                $6, --:starttime
                $7, --:endtime
                $13, --:createddate
                $8, --:userid
                $9, --:itemguid
                $10, --:moduleguid
                $11, --:userguid
                $11, --:userguid
                $12, --:location
                $14, --:ticketprice
                $15, --:requiresticket
                $13, --:createddate
				$16 --:showmap
);

select cast(currval('mp_calendarevents_itemid_seq') as int4);
$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_select_bydate(integer, date, date)
 RETURNS SETOF mp_calendarevents_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
/*
Author:   			
Created: 			4/17/2005
Last Modified: 		2019/09/18
*/

select
    itemid,
	moduleid,
	title,
	description,
	imagename,
	eventdate,
	starttime,
	endtime,
	createddate,
	userid,
	itemguid,
	moduleguid,
	userguid,
	location,
	lastmoduserguid,
	lastmodutc,
	ticketprice,
    requiresticket,
	showmap
from
        mp_calendarevents
        
where   moduleid = $1
	AND  eventdate >= $2
        AND eventdate <= $3

order by eventdate, starttime;
$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_select_one(integer)
 RETURNS SETOF mp_calendarevents_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

/*
Author:   			
Created: 			4/17/2005
Last Modified: 		2019/09/18
*/

select
    itemid,
	moduleid,
	title,
	description,
	imagename,
	eventdate,
	starttime,
	endtime,
	createddate,
	userid,
	itemguid,
	moduleguid,
	userguid,
	location,
	lastmoduserguid,
	lastmodutc,
	ticketprice,
    requiresticket,
	showmap
from
        mp_calendarevents
        
where
        itemid = $1;
		$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_selectbypage(integer, integer)
 RETURNS SETOF mp_calendarevents_selectbypage_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select
		gi.itemid,
		gi.moduleid,
		gi.title, 
		gi.description, 
		m.moduletitle,
		md.featurename
		
from
		mp_calendarevents gi
		
JOIN		mp_modules m
ON		gi.moduleid = m.moduleid

JOIN		mp_moduledefinitions md
ON		m.moduledefid = md.moduledefid

JOIN		mp_pagemodules pm
ON		pm.moduleid = m.moduleid

JOIN		mp_pages p
ON		p.pageid = pm.pageid
		
where
		p.siteid = $1
		AND pm.pageid = $2
		; $function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_update(integer, integer, character varying, text, character varying, timestamp without time zone, timestamp without time zone, timestamp without time zone, character, text, timestamp without time zone, numeric, boolean)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
/*
Author:   			
Updated By:			Joseph Hill
Created: 			4/17/2005
Last Modified: 			8/27/2005
*/
declare
	_itemid alias for $1;
	_moduleid alias for $2;
	_title alias for $3;
	_description alias for $4;
	_imagename alias for $5;
	_eventdate alias for $6;
	_starttime alias for $7;
	_endtime alias for $8;
	_lastmoduserguid alias for $9;
	_location alias for $10;
	_lastmodutc alias for $11;
	_ticketprice alias for $12;
	_requiresticket alias for $13;
	_rowcount int4;
begin

update 		mp_calendarevents

set
            moduleid = _moduleid, --:moduleid
            title = _title, --:title
            description = _description, --:description
            imagename = _imagename, --:imagename
            eventdate = _eventdate, --:eventdate
            starttime = _starttime, --:starttime
            endtime = _endtime, --:endtime
            lastmoduserguid = _lastmoduserguid,
            location = _location,
            lastmodutc = _lastmodutc,
            ticketprice = _ticketprice,
            requiresticket = _requiresticket
            
where
            itemid = _itemid; --:itemid

GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_update(integer, integer, character varying, text, character varying, timestamp without time zone, timestamp without time zone, timestamp without time zone, character, text, timestamp without time zone, numeric, boolean, boolean)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
/*
Author:   			
Updated By:			Joseph Hill
Created: 			4/17/2005
Last Modified: 			9/18/2019
*/
declare
	_itemid alias for $1;
	_moduleid alias for $2;
	_title alias for $3;
	_description alias for $4;
	_imagename alias for $5;
	_eventdate alias for $6;
	_starttime alias for $7;
	_endtime alias for $8;
	_lastmoduserguid alias for $9;
	_location alias for $10;
	_lastmodutc alias for $11;
	_ticketprice alias for $12;
	_requiresticket alias for $13;
	_showmap alias for $14;
	_rowcount int4;
begin

update 		mp_calendarevents

set
            moduleid = _moduleid, --:moduleid
            title = _title, --:title
            description = _description, --:description
            imagename = _imagename, --:imagename
            eventdate = _eventdate, --:eventdate
            starttime = _starttime, --:starttime
            endtime = _endtime, --:endtime
            lastmoduserguid = _lastmoduserguid,
            location = _location,
            lastmodutc = _lastmodutc,
            ticketprice = _ticketprice,
            requiresticket = _requiresticket,
			showmap = _showmap
            
where
            itemid = _itemid; --:itemid

GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end $function$
;

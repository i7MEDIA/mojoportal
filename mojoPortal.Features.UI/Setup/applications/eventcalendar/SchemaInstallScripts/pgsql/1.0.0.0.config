SET check_function_bodies = false;

CREATE SEQUENCE public.mp_calendarevents_itemid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;

CREATE TABLE public.mp_calendarevents (
    itemid integer DEFAULT nextval(('"mp_calendarevents_itemid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    title character varying(255),
    description text,
    imagename character varying(100),
    eventdate timestamp without time zone,
    starttime timestamp without time zone,
    endtime timestamp without time zone,
    createddate timestamp without time zone,
    userid integer DEFAULT 0 NOT NULL,
    itemguid character varying(36),
    moduleguid character varying(36),
    userguid character varying(36),
    lastmoduserguid character varying(36),
    location text,
    lastmodutc timestamp without time zone,
    requiresticket boolean DEFAULT false NOT NULL,
    ticketprice numeric(15,4),
    showmap boolean
);

ALTER TABLE ONLY public.mp_calendarevents
    ADD CONSTRAINT pk_calendarevents PRIMARY KEY (itemid);

CREATE INDEX ifk_calendarevents_moduleid ON public.mp_calendarevents USING btree (moduleid);

CREATE INDEX ifk_calendarevents_userid ON public.mp_calendarevents USING btree (userid);

CREATE TYPE public.mp_calendarevents_select_one_type AS (
	itemid integer,
	moduleid integer,
	title character varying(255),
	description text,
	imagename character varying(100),
	eventdate timestamp without time zone,
	starttime timestamp without time zone,
	endtime timestamp without time zone,
	createddate timestamp without time zone,
	userid integer,
	itemguid character(36),
	moduleguid character(36),
	userguid character(36),
	location text,
	lastmoduserguid character(36),
	lastmodutc timestamp without time zone,
	ticketprice numeric(15,4),
	requiresticket boolean,
	showmap boolean
);
CREATE TYPE public.mp_calendarevents_selectbypage_type AS (
	itemid integer,
	moduleid integer,
	title character varying(255),
	description text,
	moduletitle character varying(255),
	featurename character varying(255)
);

CREATE OR REPLACE FUNCTION public.mp_calendarevents_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_itemid alias for $1;
	_rowcount int4;
begin

/*
Author:   			
Created: 			4/17/2005
Last Modified: 			4/17/2005
*/	
	
	delete from mp_calendarevents
	where itemid = _itemid;
	
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_insert(integer, character varying, text, character varying, timestamp without time zone, timestamp without time zone, timestamp without time zone, integer, character, character, character, text, timestamp without time zone, numeric, boolean)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
/*
Author:   			
Created: 			4/17/2005
Last Modified: 			2008-01-31

*/

insert into 	mp_calendarevents
(				
                moduleid,
                title,
                description,
                imagename,
                eventdate,
                starttime,
                endtime,
                createddate,
                userid,
                itemguid,
                moduleguid,
                userguid,
                lastmoduserguid,
                location,
                ticketprice,
                requiresticket,
                lastmodutc
) 
values 
(				
                $1, --:moduleid
                $2, --:title
                $3, --:description
                $4, --:imagename
                $5, --:eventdate
                $6, --:starttime
                $7, --:endtime
                $13, --:createddate
                $8, --:userid
                $9,
                $10,
                $11,
                $11,
                $12,
                $14,
                $15,
                $13
);

select cast(currval('mp_calendarevents_itemid_seq') as int4);$function$
;
CREATE OR REPLACE FUNCTION public.mp_calendarevents_insert(integer, character varying, text, character varying, timestamp without time zone, timestamp without time zone, timestamp without time zone, integer, character, character, character, text, timestamp without time zone, numeric, boolean, boolean)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
/*
Author:   			
Created: 			4/17/2005
Last Modified: 			2008-01-31

*/

insert into 	mp_calendarevents
(				
                moduleid,
                title,
                description,

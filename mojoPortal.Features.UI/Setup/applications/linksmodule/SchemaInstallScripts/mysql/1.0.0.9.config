SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_Links` (
  `ItemID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `Title` varchar(255) DEFAULT NULL,
  `Url` text NOT NULL,
  `ViewOrder` int DEFAULT NULL,
  `Description` longtext,
  `CreatedDate` datetime DEFAULT NULL,
  `CreatedBy` int DEFAULT NULL,
  `Target` varchar(20) DEFAULT '_blank',
  `ItemGuid` varchar(36) DEFAULT NULL,
  `ModuleGuid` varchar(36) DEFAULT NULL,
  `UserGuid` varchar(36) DEFAULT NULL,
  PRIMARY KEY (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

SET FOREIGN_KEY_CHECKS = 1;

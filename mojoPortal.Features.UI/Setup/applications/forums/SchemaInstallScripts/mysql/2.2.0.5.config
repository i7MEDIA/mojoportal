SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `mp_ForumPosts` (
  `PostID` int NOT NULL AUTO_INCREMENT,
  `ThreadID` int NOT NULL DEFAULT '0',
  `ThreadSequence` int NOT NULL DEFAULT '1',
  `Subject` varchar(255) NOT NULL DEFAULT '',
  `PostDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `Approved` tinyint unsigned NOT NULL DEFAULT '1',
  `UserID` int NOT NULL DEFAULT '0',
  `SortOrder` int NOT NULL DEFAULT '100',
  `Post` mediumtext,
  `PostGuid` varchar(36) DEFAULT NULL,
  `AnswerVotes` int NOT NULL DEFAULT '0',
  `ApprovedBy` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  `ApprovedUtc` datetime DEFAULT NULL,
  `UserIp` varchar(50) DEFAULT NULL,
  `NotificationSent` tinyint unsigned NOT NULL DEFAULT '1',
  `ModStatus` int NOT NULL DEFAULT '1',
  PRIMARY KEY (`PostID`),
  KEY `FK_mp_ForumPosts_Thread` (`ThreadID`),
  KEY `idxforumpostuid` (`UserID`),
  CONSTRAINT `FK_mp_ForumPosts_Thread` FOREIGN KEY (`ThreadID`) REFERENCES `mp_ForumThreads` (`ThreadID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_ForumSubscriptions` (
  `SubscriptionID` int NOT NULL AUTO_INCREMENT,
  `ForumID` int NOT NULL DEFAULT '0',
  `UserID` int NOT NULL DEFAULT '0',
  `SubscribeDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `UnSubscribeDate` datetime DEFAULT NULL,
  `SubGuid` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  PRIMARY KEY (`SubscriptionID`),
  KEY `idxforumsubuid` (`SubGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_ForumThreadSubscriptions` (
  `ThreadSubscriptionID` int NOT NULL AUTO_INCREMENT,
  `ThreadID` int NOT NULL DEFAULT '0',
  `UserID` int NOT NULL DEFAULT '0',
  `SubscribeDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `UnSubscribeDate` datetime DEFAULT NULL,
  `SubGuid` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  PRIMARY KEY (`ThreadSubscriptionID`),
  KEY `FK_mp_ForumThreadSubThread` (`ThreadID`),
  KEY `idxforumthreadsubuid` (`SubGuid`),
  CONSTRAINT `FK_mp_ForumThreadSubThread` FOREIGN KEY (`ThreadID`) REFERENCES `mp_ForumThreads` (`ThreadID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_ForumThreads` (
  `ThreadID` int NOT NULL AUTO_INCREMENT,
  `ForumID` int NOT NULL DEFAULT '0',
  `ThreadSubject` varchar(255) NOT NULL DEFAULT '',
  `ThreadDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `TotalViews` int NOT NULL DEFAULT '0',
  `TotalReplies` int NOT NULL DEFAULT '0',
  `SortOrder` int NOT NULL DEFAULT '1000',
  `IsLocked` tinyint unsigned NOT NULL DEFAULT '0',
  `ForumSequence` int NOT NULL DEFAULT '1',
  `MostRecentPostDate` datetime DEFAULT NULL,
  `MostRecentPostUserID` int DEFAULT NULL,
  `StartedByUserID` int NOT NULL DEFAULT '0',
  `ThreadGuid` varchar(36) DEFAULT NULL,
  `IsQuestion` tinyint unsigned NOT NULL DEFAULT '1',
  `IncludeInSiteMap` tinyint unsigned NOT NULL DEFAULT '1',
  `SetNoIndexMeta` tinyint unsigned NOT NULL DEFAULT '0',
  `PTitleOverride` varchar(255) DEFAULT NULL,
  `ModStatus` int NOT NULL DEFAULT '1',
  `ThreadType` varchar(100) DEFAULT NULL,
  `AssignedTo` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  `LockedBy` varchar(36) NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  `LockedReason` varchar(255) DEFAULT NULL,
  `LockedUtc` datetime DEFAULT NULL,
  PRIMARY KEY (`ThreadID`),
  KEY `FK_mp_ForumThreads_Forum` (`ForumID`),
  CONSTRAINT `FK_mp_ForumThreads_Forum` FOREIGN KEY (`ForumID`) REFERENCES `mp_Forums` (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;
CREATE TABLE `mp_Forums` (
  `ItemID` int NOT NULL AUTO_INCREMENT,
  `ModuleID` int NOT NULL DEFAULT '0',
  `CreatedDate` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `CreatedBy` int NOT NULL DEFAULT '0',
  `Title` varchar(100) NOT NULL DEFAULT '',
  `Description` text NOT NULL,
  `IsModerated` tinyint unsigned NOT NULL DEFAULT '0',
  `IsActive` tinyint unsigned NOT NULL DEFAULT '0',
  `SortOrder` int NOT NULL DEFAULT '100',
  `ThreadCount` int NOT NULL DEFAULT '0',
  `PostCount` int NOT NULL DEFAULT '0',
  `MostRecentPostDate` datetime DEFAULT NULL,
  `MostRecentPostUserID` int NOT NULL DEFAULT '0',
  `PostsPerPage` int NOT NULL DEFAULT '10',
  `ThreadsPerPage` int DEFAULT '20',
  `AllowAnonymousPosts` tinyint unsigned NOT NULL DEFAULT '1',
  `ForumGuid` varchar(36) DEFAULT NULL,
  `RolesThatCanPost` text,
  `RolesThatCanModerate` text,
  `ModeratorNotifyEmail` text,
  `IncludeInGoogleMap` tinyint unsigned NOT NULL DEFAULT '1',
  `AddNoIndexMeta` tinyint unsigned NOT NULL DEFAULT '0',
  `Closed` tinyint unsigned NOT NULL DEFAULT '0',
  `Visible` tinyint unsigned NOT NULL DEFAULT '1',
  `RequireModeration` tinyint unsigned NOT NULL DEFAULT '0',
  `RequireModForNotify` tinyint unsigned NOT NULL DEFAULT '0',
  `AllowTrustedDirectPosts` tinyint unsigned NOT NULL DEFAULT '0',
  `AllowTrustedDirectNotify` tinyint unsigned NOT NULL DEFAULT '0',
  PRIMARY KEY (`ItemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3;

SET FOREIGN_KEY_CHECKS = 1;

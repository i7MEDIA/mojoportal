CREATE OR REPLACE FUNCTION public.mp_forumsubscriptions_exists(integer, integer)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select	cast(count(*) as int4)
from		mp_forumsubscriptions
where	forumid = $1 AND userid = $2 AND unsubscribedate is null; $function$
;
CREATE OR REPLACE FUNCTION public.mp_forumsubscriptions_insert(integer, integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_forumid alias for $1;
	_userid alias for $2;
	t_found int;
	_rowcount int4;

begin

select into t_found 1 
from mp_forumsubscriptions 
where 	forumid = _forumid and userid = _userid limit 1;

if  found then
	update 	mp_forumsubscriptions
	set		subscribedate = current_timestamp(3),
			unsubscribedate = null
	
	where 	forumid = _forumid and userid = _userid;
else
	insert into	mp_forumsubscriptions
	(
			forumid,
			userid
	)
	values
	(
			_forumid,
			_userid
	);   
end if;
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

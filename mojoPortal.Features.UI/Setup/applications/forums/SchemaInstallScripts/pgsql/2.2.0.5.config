SET check_function_bodies = false;

CREATE SEQUENCE public.mp_forumposts_postid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_forums_itemid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_forumsubscriptions_subscriptionid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_forumthreads_threadid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.mp_forumthreadsubscriptions_threadsubscriptionid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;

CREATE TABLE public.mp_forumposts (
    postid integer DEFAULT nextval(('"mp_forumposts_postid_seq"'::text)::regclass) NOT NULL,
    threadid integer NOT NULL,
    threadsequence integer DEFAULT 1 NOT NULL,
    subject character varying(255) NOT NULL,
    postdate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL,
    approved boolean DEFAULT false NOT NULL,
    userid integer DEFAULT '-1'::integer NOT NULL,
    sortorder integer DEFAULT 100 NOT NULL,
    post text NOT NULL,
    postguid character varying(36),
    answervotes integer DEFAULT 0 NOT NULL,
    approvedby character varying(36) DEFAULT '00000000-0000-0000-0000-000000000000'::character varying NOT NULL,
    approvedutc timestamp without time zone,
    userip character varying(50),
    notificationsent boolean DEFAULT true NOT NULL,
    modstatus integer DEFAULT 1 NOT NULL
);

CREATE TABLE public.mp_forums (
    itemid integer DEFAULT nextval(('"mp_forums_itemid_seq"'::text)::regclass) NOT NULL,
    moduleid integer NOT NULL,
    createddate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL,
    createdby integer NOT NULL,
    title character varying(100) NOT NULL,
    description text NOT NULL,
    ismoderated boolean DEFAULT false NOT NULL,
    isactive boolean DEFAULT true NOT NULL,
    sortorder integer DEFAULT 100 NOT NULL,
    threadcount integer DEFAULT 0 NOT NULL,
    postcount integer DEFAULT 0 NOT NULL,
    mostrecentpostdate timestamp without time zone,
    mostrecentpostuserid integer DEFAULT '-1'::integer NOT NULL,
    postsperpage integer DEFAULT 10 NOT NULL,
    threadsperpage integer DEFAULT 40 NOT NULL,
    allowanonymousposts boolean DEFAULT true NOT NULL,
    forumguid character varying(36),
    rolesthatcanpost text DEFAULT 'Authenticated Users'::text NOT NULL,
    rolesthatcanmoderate text,
    moderatornotifyemail text,
    includeingooglemap boolean DEFAULT true NOT NULL,
    addnoindexmeta boolean DEFAULT false NOT NULL,
    closed boolean DEFAULT false NOT NULL,
    visible boolean DEFAULT true NOT NULL,
    requiremoderation boolean DEFAULT false NOT NULL,
    requiremodfornotify boolean DEFAULT false NOT NULL,
    allowtrusteddirectposts boolean DEFAULT false NOT NULL,
    allowtrusteddirectnotify boolean DEFAULT false NOT NULL
);

CREATE TABLE public.mp_forumsubscriptions (
    subscriptionid integer DEFAULT nextval(('"mp_forumsubscriptions_subscriptionid_seq"'::text)::regclass) NOT NULL,
    forumid integer NOT NULL,
    userid integer NOT NULL,
    subscribedate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL,
    unsubscribedate timestamp without time zone,
    subguid character(36) DEFAULT '00000000-0000-0000-0000-000000000000'::bpchar NOT NULL
);

CREATE TABLE public.mp_forumthreads (
    threadid integer DEFAULT nextval(('"mp_forumthreads_threadid_seq"'::text)::regclass) NOT NULL,
    forumid integer NOT NULL,
    threadsubject character varying(255) NOT NULL,
    threaddate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL,
    totalviews integer DEFAULT 0 NOT NULL,
    totalreplies integer DEFAULT 0 NOT NULL,
    sortorder integer DEFAULT 1000 NOT NULL,
    islocked boolean DEFAULT false NOT NULL,
    forumsequence integer DEFAULT 1 NOT NULL,
    mostrecentpostdate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone,
    mostrecentpostuserid integer,
    startedbyuserid integer NOT NULL,
    threadguid character varying(36),
    isquestion boolean DEFAULT true NOT NULL,
    includeinsitemap boolean DEFAULT true NOT NULL,
    setnoindexmeta boolean DEFAULT false NOT NULL,
    ptitleoverride character varying(255),
    modstatus integer DEFAULT 1 NOT NULL,
    threadtype character varying(100),
    assignedto character varying(36) DEFAULT '00000000-0000-0000-0000-000000000000'::character varying NOT NULL,
    lockedreason character varying(255),
    lockedby character varying(36) DEFAULT '00000000-0000-0000-0000-000000000000'::character varying NOT NULL,
    lockedutc timestamp without time zone
);

CREATE TABLE public.mp_forumthreadsubscriptions (
    threadsubscriptionid integer DEFAULT nextval(('"mp_forumthreadsubscriptions_threadsubscriptionid_seq"'::text)::regclass) NOT NULL,
    threadid integer NOT NULL,
    userid integer NOT NULL,
    subscribedate timestamp without time zone DEFAULT ('now'::text)::timestamp(3) with time zone NOT NULL,
    unsubscribedate timestamp without time zone,
    subguid character(36) DEFAULT '00000000-0000-0000-0000-000000000000'::bpchar NOT NULL
);

ALTER TABLE ONLY public.mp_forumposts
    ADD CONSTRAINT pk_forumposts PRIMARY KEY (postid);

ALTER TABLE ONLY public.mp_forums
    ADD CONSTRAINT pk_forums PRIMARY KEY (itemid);

ALTER TABLE ONLY public.mp_forumsubscriptions
    ADD CONSTRAINT pk_forumsubscriptions PRIMARY KEY (subscriptionid);

ALTER TABLE ONLY public.mp_forumthreads
    ADD CONSTRAINT pk_forumthreads PRIMARY KEY (threadid);

ALTER TABLE ONLY public.mp_forumthreadsubscriptions
    ADD CONSTRAINT pk_forumthreadsubscriptions PRIMARY KEY (threadsubscriptionid);

CREATE INDEX idxforumpostuid ON public.mp_forumposts USING btree (userid);

CREATE INDEX ifk_forumposts_userid ON public.mp_forumposts USING btree (userid);

CREATE INDEX ifk_forums_moduleid ON public.mp_forums USING btree (moduleid);

CREATE INDEX ifk_forumsubscriptions_forumid ON public.mp_forumsubscriptions USING btree (forumid);

CREATE INDEX ifk_forumsubscriptions_userid ON public.mp_forumsubscriptions USING btree (userid);

CREATE INDEX ifk_forumthreadsubscriptio_userid ON public.mp_forumthreadsubscriptions USING btree (userid);

ALTER TABLE ONLY public.mp_forumposts
    ADD CONSTRAINT fk_forumposts_forumthreads FOREIGN KEY (threadid) REFERENCES public.mp_forumthreads(threadid);

ALTER TABLE ONLY public.mp_forumthreads
    ADD CONSTRAINT fk_forumthreads_forums FOREIGN KEY (forumid) REFERENCES public.mp_forums(itemid);

ALTER TABLE ONLY public.mp_forumthreadsubscriptions
    ADD CONSTRAINT fk_forumthreadsubscriptions_forumthreads FOREIGN KEY (threadid) REFERENCES public.mp_forumthreads(threadid);


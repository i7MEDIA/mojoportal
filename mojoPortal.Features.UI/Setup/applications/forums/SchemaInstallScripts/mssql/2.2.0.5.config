CREATE PROCEDURE [dbo].[mp_Forums_DecrementPostCount]

/*
Author:				
Created:			2004-11-06
Last Modified:		2014-01-17

*/

@ForumID		int

AS


UPDATE [dbo].mp_Forums

SET PostCount = (

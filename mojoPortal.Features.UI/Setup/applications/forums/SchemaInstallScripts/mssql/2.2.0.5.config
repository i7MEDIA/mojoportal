CREATE PROCEDURE [dbo].[mp_ForumThreads_Update]

/*
Author:			
Created:		2004-09-19
Last Modified:	2014-06-20

*/

@ThreadID			int,
@ForumID			int,
@ThreadSubject		nvarchar(255),
@SortOrder			int,
@IsLocked			bit,
@IsQuestion bit,
@IncludeInSiteMap bit,
@SetNoIndexMeta bit,
@PTitleOverride nvarchar(255),
@ModStatus int,
@ThreadType nvarchar(100),
@AssignedTo uniqueidentifier,
@LockedBy uniqueidentifier,
@LockedReason nvarchar(255),
@LockedUtc datetime


AS


UPDATE		[dbo].mp_ForumThreads

SET			ForumID = @ForumID,
			ThreadSubject = @ThreadSubject,
			SortOrder = @SortOrder,
			IsLocked = @IsLocked,
			IsQuestion = @IsQuestion,
			IncludeInSiteMap = @IncludeInSiteMap,
			SetNoIndexMeta = @SetNoIndexMeta,
			PTitleOverride = @PTitleOverride,
			ModStatus = @ModStatus,
			ThreadType = @ThreadType,
			AssignedTo = @AssignedTo,
			LockedBy = @LockedBy,
			LockedReason = @LockedReason,
			LockedUtc = @LockedUtc


WHERE		ThreadID = @ThreadID
GO


CREATE PROCEDURE [dbo].[mp_Forums_Insert]

/*
Author:				
Created:			2004-09-12
Last Modified:		2014-06-20

*/

@ForumGuid uniqueidentifier,
@ModuleID int,
@UserID int,
@Title nvarchar(100),
@Description nvarchar(max),
@IsModerated bit,
@IsActive bit,
@SortOrder int,
@PostsPerPage int,
@ThreadsPerPage	int,
@AllowAnonymousPosts bit,
@RolesThatCanPost nvarchar(max),
@RolesThatCanModerate nvarchar(max),
@ModeratorNotifyEmail nvarchar(max),
@IncludeInGoogleMap bit,
@AddNoIndexMeta bit,
@Closed bit,
@Visible bit,
@RequireModeration bit,
@RequireModForNotify bit,
@AllowTrustedDirectPosts bit,
@AllowTrustedDirectNotify bit



AS

INSERT INTO			[dbo].mp_Forums
(
				ForumGuid,
				ModuleID,
				CreatedBy,
				Title,
				[Description],
				IsModerated,
				IsActive,
				SortOrder,
				PostsPerPage,
				ThreadsPerPage,
				AllowAnonymousPosts,
				RolesThatCanPost,
				RolesThatCanModerate,
				ModeratorNotifyEmail,
				IncludeInGoogleMap,
				AddNoIndexMeta,
				Closed,
				Visible,
				RequireModeration,
				RequireModForNotify,
				AllowTrustedDirectPosts,
				AllowTrustedDirectNotify

)

VALUES
(
				@ForumGuid,
				@ModuleID,
				@UserID,
				@Title,
				@Description,
				@IsModerated,
				@IsActive,
				@SortOrder,
				@PostsPerPage,
				@ThreadsPerPage,
				@AllowAnonymousPosts,
				@RolesThatCanPost,
				@RolesThatCanModerate,
				@ModeratorNotifyEmail,
				@IncludeInGoogleMap,
				@AddNoIndexMeta,
				@Closed,
				@Visible,
				@RequireModeration,
				@RequireModForNotify,
				@AllowTrustedDirectPosts,
				@AllowTrustedDirectNotify

)

SELECT @@IDENTITY As ItemID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_Forums_RecalculatePostStats]

/*
Author:			
Created:		2005-09-11
Last Modified:	2014-01-17

based ont he pgsql version by Dean Brettle

*/

@ForumID		int


AS

DECLARE @RowsAffected		int
DECLARE @MostRecentPostDate	datetime
DECLARE @MostRecentPostUserID	int
DECLARE @PostCount			int

SET @RowsAffected = 0

SELECT TOP 1	@MostRecentPostDate = MostRecentPostDate,
		@MostRecentPostUserID = MostRecentPostUserID

FROM		[dbo].mp_ForumThreads

WHERE	ForumID = @ForumID

ORDER BY	MostRecentPostDate DESC

SET @PostCount = (
SELECT COUNT(*) 
FROM [dbo].mp_ForumPosts p 
JOIN [dbo].mp_ForumThreads ft
ON p.ThreadID = ft.ThreadID
AND ft.ForumID = @ForumID
)

UPDATE 	[dbo].mp_Forums
SET		MostRecentPostDate = @MostRecentPostDate,
		MostRecentPostUserID = COALESCE(@MostRecentPostUserID,0),
		PostCount = @PostCount

WHERE	ItemID = @ForumID

SET @RowsAffected = @@ROWCOUNT


SELECT @RowsAffected
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_Forums_Select]


/*
Author:			
Created:		2004-09-12
Last Modified:	2013-08-18

*/

@ModuleID			int,
@UserID				int

AS


SELECT		f.*,
			u.[Name] AS MostRecentPostUser,
			CASE WHEN s.[SubscribeDate] IS NOT NULL and s.[UnSubscribeDate] IS NULL THEN 1
					Else 0
					End AS Subscribed,
			(SELECT COUNT(*) 
				FROM mp_ForumSubscriptions fs 
				WHERE fs.ForumID = f.ItemID AND fs.UnSubscribeDate IS NULL) AS SubscriberCount

FROM			[dbo].mp_Forums f

LEFT OUTER JOIN	[dbo].mp_Users u
ON			f.MostRecentPostUserID = u.UserID

LEFT OUTER JOIN [dbo].mp_ForumSubscriptions s
on			f.ItemID = s.ForumID and s.UserID = @UserID AND s.UnSubscribeDate IS NULL

WHERE		f.ModuleID	= @ModuleID
			AND f.IsActive = 1

ORDER BY		f.SortOrder, f.ItemID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_Forums_SelectOne]

/*
Author:				
Created:			2004-09-12
Last Modified:		2010-07-01

*/

@ItemID			int

AS

SELECT		f.*,
			u.[Name] AS CreatedByUser,
			up.[Name] AS MostRecentPostUser

FROM			[dbo].mp_Forums f

LEFT OUTER JOIN	[dbo].mp_Users u
ON			f.CreatedBy = u.UserID

LEFT OUTER JOIN	[dbo].mp_Users up
ON			f.MostRecentPostUserID = up.UserID

WHERE		f.ItemID = @ItemID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

/*
Author:			
Created:		2004-09-19
Last Modified:	2010-11-10

*/

@ThreadID		int


AS

SELECT		t.*,
			COALESCE(u.[Name], 'Guest') AS MostRecentPostUser,
			COALESCE(s.[Name], 'Guest') AS StartedBy,
			f.PostsPerPage,
			f.ModuleID



CREATE PROCEDURE [dbo].[mp_ForumThreads_Insert]

/*
Author:			
Created:		2004-09-19
Last Modified:	2014-06-20

*/

@ForumID			int,
@ThreadSubject		nvarchar(255),
@SortOrder			int,
@IsLocked			bit,
@StartedByUserID		int,
@ThreadDate		datetime,
@ThreadGuid uniqueidentifier,
@IsQuestion bit,
@IncludeInSiteMap bit,
@SetNoIndexMeta bit,
@PTitleOverride nvarchar(255),
@ModStatus int,
@ThreadType nvarchar(100)



AS
DECLARE @ThreadID int
DECLARE @ForumSequence int
SET @ForumSequence = (SELECT COALESCE(Max(ForumSequence) + 1,1) FROM [dbo].mp_ForumThreads WHERE ForumID = @ForumID)

INSERT INTO		[dbo].mp_ForumThreads
(
			ForumID,
			ThreadSubject,
			SortOrder,
			ForumSequence,
			IsLocked,
			StartedByUserID,
			ThreadDate,
			MostRecentPostUserID,
			MostRecentPostDate,
			ThreadGuid,
			IsQuestion,
			IncludeInSiteMap,
			SetNoIndexMeta,
			PTitleOverride,
			ModStatus,
			ThreadType

)

VALUES
(
			
			@ForumID,
			@ThreadSubject,
			@SortOrder,
			@ForumSequence,
			@IsLocked,
			@StartedByUserID,
			@ThreadDate,
			@StartedByUserID,
			@ThreadDate,
			@ThreadGuid,
			@IsQuestion,
			@IncludeInSiteMap,
			@SetNoIndexMeta,
			@PTitleOverride,
			@ModStatus,
			@ThreadType


)

SELECT @@IDENTITY  AS ThreadID
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_ForumThreads_SelectByForumDesc_v2]

/*
Author:			
Created:		2004-09-25
Last Modified:	2010-04-13

*/


@ForumID			int,
@PageNumber			int

AS

DECLARE @ThreadsPerPage	int
DECLARE @TotalThreads	int

SELECT	@ThreadsPerPage = ThreadsPerPage,
		@TotalThreads = ThreadCount
FROM		mp_Forums
WHERE	ItemID = @ForumID


DECLARE @PageLowerBound int
DECLARE @PageUpperBound int


SET @PageLowerBound = (@ThreadsPerPage * @PageNumber) - @ThreadsPerPage
SET @PageUpperBound = @PageLowerBound + @ThreadsPerPage + 1

CREATE TABLE #PageIndex 
(
	IndexID int IDENTITY (1, 1) NOT NULL,
	ThreadID int
	
)

INSERT INTO #PageIndex (ThreadID)


SELECT	t.ThreadID
FROM		[dbo].mp_ForumThreads t
WHERE	t.ForumID = @ForumID	
ORDER BY t.SortOrder,	t.MostRecentPostDate DESC


SELECT	t.*,
		u.[Name] AS MostRecentPostUser,
		s.[Name] AS StartedBy


FROM		[dbo].mp_ForumThreads t

JOIN		#PageIndex p
ON		p.ThreadID = t.ThreadID

LEFT OUTER JOIN		[dbo].mp_Users u
ON		t.MostRecentPostUserID = u.UserID

LEFT OUTER JOIN		[dbo].mp_Users s
ON		t.StartedByUserID = s.UserID

WHERE	t.ForumID = @ForumID

		

AND p.IndexID > @PageLowerBound 
		AND p.IndexID < @PageUpperBound

ORDER BY	p.IndexID 

DROP TABLE #PageIndex
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
CREATE PROCEDURE [dbo].[mp_ForumThreads_SelectByPage]

/*
Author:			Joe Audettte
Created:		2005-07-02
Last Modified:	2009-06-24

*/


@SiteID		int,
@PageID		int

AS
SELECT  	fp.*,
		f.ModuleID,
		f.ItemID,
		m.ModuleTitle,
		m.ViewRoles,
		md.FeatureName

FROM		[dbo].mp_ForumPosts fp

JOIN		[dbo].mp_ForumThreads ft
ON		fp.ThreadID = ft.ThreadID

JOIN		[dbo].mp_Forums f
ON		f.ItemID = ft.ForumID

JOIN		[dbo].mp_Modules m
ON		f.ModuleID = m.ModuleID

JOIN		[dbo].mp_ModuleDefinitions md
ON		m.ModuleDefID = md.ModuleDefID

JOIN		[dbo].mp_PageModules pm
ON			pm.ModuleID = m.ModuleID

JOIN		[dbo].mp_Pages p
ON		p.PageID = pm.PageID

WHERE	p.SiteID = @SiteID
		AND pm.PageID = @PageID
		AND fp.Approved = 1
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_ForumThreads_SelectForSiteMap]

/*
Author:			Joe Audettte
Created:		2012-10-26
Last Modified:	2012-12-17

*/


@SiteID		int

AS
SELECT  	
		ft.ThreadID,
		ft.MostRecentPostDate,
		f.ModuleID,
		m.ViewRoles,
		p.PageID,
		p.AuthorizedRoles

FROM		[dbo].mp_ForumThreads ft


JOIN		[dbo].mp_Forums f
ON		f.ItemID = ft.ForumID

JOIN		[dbo].mp_Modules m
ON		f.ModuleID = m.ModuleID


JOIN		[dbo].mp_PageModules pm
ON			pm.ModuleID = m.ModuleID

JOIN		[dbo].mp_Pages p
ON		p.PageID = pm.PageID

WHERE	p.SiteID = @SiteID
AND ft.IncludeInSiteMap = 1

ORDER BY ft.ThreadID DESC
GO


SET check_function_bodies = false;

CREATE TABLE public.mp_surveymodules (
    surveyguid character(36) NOT NULL,
    moduleid integer NOT NULL
);

CREATE TABLE public.mp_surveypages (
    pageguid character(36) NOT NULL,
    surveyguid character(36) NOT NULL,
    pagetitle character varying(255) NOT NULL,
    pageorder integer NOT NULL,
    pageenabled boolean NOT NULL
);

CREATE TABLE public.mp_surveyquestionanswers (
    answerguid character(36) NOT NULL,
    questionguid character(36) NOT NULL,
    responseguid character(36) NOT NULL,
    answer text NOT NULL,
    answereddate timestamp without time zone NOT NULL
);

CREATE TABLE public.mp_surveyquestionoptions (
    questionoptionguid character(36) NOT NULL,
    questionguid character(36) NOT NULL,
    answer character varying(255) NOT NULL,
    "order" integer NOT NULL
);

CREATE TABLE public.mp_surveyquestions (
    questionguid character(36) NOT NULL,
    pageguid character(36) NOT NULL,
    questiontext text,
    questiontypeid integer NOT NULL,
    answerisrequired boolean NOT NULL,
    questionorder integer NOT NULL,
    validationmessage character varying(255) NOT NULL,
    questionname character varying(255)
);

CREATE TABLE public.mp_surveyresponses (
    responseguid character(36) NOT NULL,
    surveyguid character(36) NOT NULL,
    submissiondate timestamp without time zone,
    annonymous boolean NOT NULL,
    complete boolean NOT NULL,
    userguid character(36)
);

CREATE TABLE public.mp_surveys (
    surveyguid character(36) NOT NULL,
    siteguid character(36) NOT NULL,
    surveyname character varying(255) NOT NULL,
    creationdate timestamp without time zone NOT NULL,
    startpagetext text,
    endpagetext text,
    submissionlimit integer DEFAULT 1 NOT NULL
);

ALTER TABLE ONLY public.mp_surveymodules
    ADD CONSTRAINT pk_surveymodules PRIMARY KEY (surveyguid, moduleid);

ALTER TABLE ONLY public.mp_surveypages
    ADD CONSTRAINT pk_surveypages PRIMARY KEY (pageguid);

ALTER TABLE ONLY public.mp_surveyquestionanswers
    ADD CONSTRAINT pk_surveyquestionanswers PRIMARY KEY (answerguid);

ALTER TABLE ONLY public.mp_surveyquestionoptions
    ADD CONSTRAINT pk_surveyquestionoptions PRIMARY KEY (questionoptionguid);

ALTER TABLE ONLY public.mp_surveyquestions
    ADD CONSTRAINT pk_surveyquestions PRIMARY KEY (questionguid);

ALTER TABLE ONLY public.mp_surveyresponses
    ADD CONSTRAINT pk_surveyresponses PRIMARY KEY (responseguid);

ALTER TABLE ONLY public.mp_surveys
    ADD CONSTRAINT pk_surveys PRIMARY KEY (surveyguid);

CREATE UNIQUE INDEX mp_surveymodules_pkey ON public.mp_surveymodules USING btree (surveyguid, moduleid);

CREATE UNIQUE INDEX mp_surveypages_pkey ON public.mp_surveypages USING btree (pageguid);

CREATE UNIQUE INDEX mp_surveyquestionanswers_pkey ON public.mp_surveyquestionanswers USING btree (answerguid);

CREATE UNIQUE INDEX mp_surveyquestionoptions_pkey ON public.mp_surveyquestionoptions USING btree (questionoptionguid);

CREATE UNIQUE INDEX mp_surveyquestions_pkey ON public.mp_surveyquestions USING btree (questionguid);

CREATE UNIQUE INDEX mp_surveyresponses_pkey ON public.mp_surveyresponses USING btree (responseguid);

CREATE UNIQUE INDEX mp_surveys_pkey ON public.mp_surveys USING btree (surveyguid);

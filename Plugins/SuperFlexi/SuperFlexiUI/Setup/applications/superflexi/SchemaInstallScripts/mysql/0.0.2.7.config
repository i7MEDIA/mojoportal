SET SESSION sql_mode = REPLACE(REPLACE(@@sql_mode, 'NO_ZERO_DATE', ''), 'NO_ZERO_IN_DATE', '');
SET FOREIGN_KEY_CHECKS = 0;

CREATE TABLE `i7_sflexi_fields` (
  `SiteGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FeatureGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `DefinitionGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FieldGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `DefinitionName` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `Name` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `Label` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `DefaultValue` longtext COLLATE utf8mb4_unicode_ci,
  `ControlType` varchar(25) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `ControlSrc` longtext COLLATE utf8mb4_unicode_ci,
  `SortOrder` int DEFAULT NULL,
  `HelpKey` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `Required` tinyint(1) DEFAULT NULL,
  `RequiredMessageFormat` text COLLATE utf8mb4_unicode_ci,
  `Regex` longtext COLLATE utf8mb4_unicode_ci,
  `RegexMessageFormat` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `Token` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `Searchable` tinyint(1) DEFAULT NULL,
  `EditPageControlWrapperCssClass` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `EditPageLabelCssClass` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `EditPageControlCssClass` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `DatePickerIncludeTimeForDate` tinyint(1) DEFAULT NULL,
  `DatePickerShowMonthList` tinyint(1) DEFAULT NULL,
  `DatePickerShowYearList` tinyint(1) DEFAULT NULL,
  `DatePickerYearRange` varchar(10) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `ImageBrowserEmptyUrl` longtext COLLATE utf8mb4_unicode_ci,
  `Options` longtext COLLATE utf8mb4_unicode_ci,
  `CheckBoxReturnBool` tinyint(1) DEFAULT NULL,
  `CheckBoxReturnValueWhenTrue` longtext COLLATE utf8mb4_unicode_ci,
  `CheckBoxReturnValueWhenFalse` longtext COLLATE utf8mb4_unicode_ci,
  `DateFormat` text COLLATE utf8mb4_unicode_ci,
  `TextBoxMode` varchar(25) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `Attributes` longtext COLLATE utf8mb4_unicode_ci,
  `IsDeleted` tinyint(1) DEFAULT '0',
  `PreTokenString` longtext COLLATE utf8mb4_unicode_ci,
  `PostTokenString` longtext COLLATE utf8mb4_unicode_ci,
  `IsGlobal` tinyint(1) DEFAULT NULL,
  `ViewRoles` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `EditRoles` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `PreTokenStringWhenTrue` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `PostTokenStringWhenTrue` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `PreTokenStringWhenFalse` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `PostTokenStringWhenFalse` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `DataType` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT 'string',
  `IsList` tinyint(1) DEFAULT '0',
  PRIMARY KEY (`FieldGuid`),
  UNIQUE KEY `FieldGuid` (`FieldGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE `i7_sflexi_items` (
  `SiteGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FeatureGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ModuleGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ModuleID` int NOT NULL,
  `DefinitionGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ItemGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ItemID` int NOT NULL AUTO_INCREMENT,
  `SortOrder` int NOT NULL,
  `CreatedUtc` datetime NOT NULL,
  `LastModUtc` datetime NOT NULL,
  `ViewRoles` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `EditRoles` text COLLATE utf8mb4_unicode_ci NOT NULL,
  PRIMARY KEY (`ItemID`,`ItemGuid`),
  UNIQUE KEY `ItemGuid` (`ItemGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE `i7_sflexi_searchdefs` (
  `Guid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `SiteGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FeatureGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FieldDefinitionGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `Title` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `Keywords` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `Description` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `Link` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  `LinkQueryAddendum` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  PRIMARY KEY (`Guid`),
  UNIQUE KEY `Guid` (`Guid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
CREATE TABLE `i7_sflexi_values` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `ValueGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `SiteGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FeatureGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ModuleGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `ItemGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FieldGuid` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,
  `FieldValue` longtext COLLATE utf8mb4_unicode_ci NOT NULL,
  PRIMARY KEY (`Id`),
  UNIQUE KEY `ValueGuid` (`ValueGuid`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

SET FOREIGN_KEY_CHECKS = 1;

CREATE PROCEDURE [dbo].i7_sflexi_values_SelectPage

-- Author:   			i7MEDIA
-- Created: 			2015-3-6
-- Last Modified: 		2015-3-6

@PageNumber 			int,
@PageSize 			int

AS

DECLARE @PageLowerBound int
DECLARE @PageUpperBound int


SET @PageLowerBound = (@PageSize * @PageNumber) - @PageSize
SET @PageUpperBound = @PageLowerBound + @PageSize + 1

/*
Note: temp tables use the server default for collation not the database default
so if adding character columns be sure and specify to use the database collation like this
to avoid collation errors:

CREATE TABLE #PageIndexForUsers
(
IndexID int IDENTITY (1, 1) NOT NULL,
UserName nvarchar(50) COLLATE DATABASE_DEFAULT,
LoginName nvarchar(50) COLLATE DATABASE_DEFAULT
) 


*/

CREATE TABLE #PageIndex 
(
	IndexID int IDENTITY (1, 1) NOT NULL,
ValueGuid UniqueIdentifier
)

BEGIN

INSERT INTO #PageIndex ( 
ValueGuid
)

SELECT
		[ValueGuid]
		
FROM
		[dbo].[i7_sflexi_values]
		
-- WHERE

-- ORDER BY

END


SELECT
		t1.*
		
FROM
		[dbo].[i7_sflexi_values] t1

JOIN			#PageIndex t2
ON			
		t1.[ValueGuid] = t2.[ValueGuid]
		
WHERE
		t2.IndexID > @PageLowerBound 
		AND t2.IndexID < @PageUpperBound
		
ORDER BY t2.IndexID

DROP TABLE #PageIndex
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
CREATE PROCEDURE [dbo].[i7_sflexi_values_SelectPageForField]
	-- Author:   			i7MEDIA
	-- Created: 			2017-11-06
	-- Last Modified: 		2017-11-06
	@ModuleGuid UNIQUEIDENTIFIER
	,@DefinitionGuid UNIQUEIDENTIFIER
	,@PageNumber INT
	,@PageSize INT
	,@Field NVARCHAR(max)
	,@SortDirection VARCHAR(4)
AS
SELECT TOP (@PageSize) *
FROM (
	SELECT RowID = ROW_NUMBER() OVER (ORDER BY [Id])
		,TotalRows = Count(*) OVER ()
		,v.*
	FROM [dbo].[i7_sflexi_values] v
	JOIN (
		SELECT DISTINCT FieldGuid
		FROM [dbo].[i7_sflexi_fields]
		WHERE Name = @Field
		AND DefinitionGuid = @DefinitionGuid
		) f ON f.FieldGuid = v.FieldGuid
	WHERE [ModuleGuid] = @ModuleGuid
	) a
WHERE a.RowID > ((@PageNumber - 1) * @PageSize)
ORDER BY 
	CASE WHEN @SortDirection = 'DESC' THEN [Id] END DESC,
	CASE WHEN @SortDirection = 'ASC' THEN [Id] END
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[i7_sflexi_values_SelectPageForFieldWithTerm]
	-- Author:   			i7MEDIA
	-- Created: 			2017-11-06
	-- Last Modified: 		2017-11-06
	@ModuleGuid UNIQUEIDENTIFIER
	,@DefinitionGuid UNIQUEIDENTIFIER
	,@PageNumber INT
	,@PageSize INT
	,@SearchTerm NVARCHAR(max)
	,@Field NVARCHAR(max)
	,@SortDirection VARCHAR(4)
AS
SELECT TOP (@PageSize) *
FROM (
	SELECT RowID = ROW_NUMBER() OVER (ORDER BY [Id])
		,TotalRows = Count(*) OVER ()
		,v.*
		,f.FieldName
	FROM [dbo].[i7_sflexi_values] v
	JOIN (
		SELECT DISTINCT FieldGuid, [Name] AS [FieldName]
		FROM [dbo].[i7_sflexi_fields] f
		WHERE f.[Name] = @Field
		AND f.DefinitionGuid = @DefinitionGuid
		) f ON f.FieldGuid = v.FieldGuid
	WHERE [ModuleGuid] = @ModuleGuid
	AND v.FieldValue LIKE '%' + @SearchTerm + '%'
	) a
WHERE a.RowID > ((@PageNumber - 1) * @PageSize)
ORDER BY 
	CASE WHEN @SortDirection = 'DESC' THEN [Id] END DESC,
	CASE WHEN @SortDirection = 'ASC' THEN [Id] END
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].i7_sflexi_values_Update

/*
Author:   			i7MEDIA
Created: 			2015-3-6
Last Modified: 		2015-3-6
*/
	
@ValueGuid uniqueidentifier, 
@SiteGuid uniqueidentifier, 
@FeatureGuid uniqueidentifier, 
@ModuleGuid uniqueidentifier, 
@ItemGuid uniqueidentifier, 
@FieldGuid uniqueidentifier, 
@FieldValue nvarchar(max) 


AS

UPDATE 		[dbo].[i7_sflexi_values] 

SET
			[SiteGuid] = @SiteGuid,
			[FeatureGuid] = @FeatureGuid,
			[ModuleGuid] = @ModuleGuid,
			[ItemGuid] = @ItemGuid,
			[FieldGuid] = @FieldGuid,
			[FieldValue] = @FieldValue
			
WHERE
			[ValueGuid] = @ValueGuid
GO


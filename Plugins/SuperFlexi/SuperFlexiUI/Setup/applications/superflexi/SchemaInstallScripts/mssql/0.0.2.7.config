CREATE PROCEDURE [dbo].i7_sflexi_items_SelectPage

-- Author:   			i7MEDIA
-- Created: 			2015-3-6
-- Last Modified: 		2015-3-6

@PageNumber 			int,
@PageSize 			int

AS

DECLARE @PageLowerBound int
DECLARE @PageUpperBound int


SET @PageLowerBound = (@PageSize * @PageNumber) - @PageSize
SET @PageUpperBound = @PageLowerBound + @PageSize + 1

/*
Note: temp tables use the server default for collation not the database default
so if adding character columns be sure and specify to use the database collation like this
to avoid collation errors:

CREATE TABLE #PageIndexForUsers
(
IndexID int IDENTITY (1, 1) NOT NULL,
UserName nvarchar(50) COLLATE DATABASE_DEFAULT,
LoginName nvarchar(50) COLLATE DATABASE_DEFAULT
) 


*/

CREATE TABLE #PageIndex 
(
	IndexID int IDENTITY (1, 1) NOT NULL,
ItemGuid UniqueIdentifier
)

BEGIN

INSERT INTO #PageIndex ( 
ItemGuid
)

SELECT
		[ItemGuid]
		
FROM
		[dbo].[i7_sflexi_items]
		
-- WHERE

-- ORDER BY

END


SELECT
		t1.*
		
FROM
		[dbo].[i7_sflexi_items] t1

JOIN			#PageIndex t2
ON			
		t1.[ItemGuid] = t2.[ItemGuid]
		
WHERE
		t2.IndexID > @PageLowerBound 
		AND t2.IndexID < @PageUpperBound
		
ORDER BY t2.IndexID

DROP TABLE #PageIndex
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
/********************************************************************
ALTER SelectPageForDefinition
********************************************************************/
CREATE PROCEDURE [dbo].[i7_sflexi_items_SelectPageForDefinition]

@DefGuid UNIQUEIDENTIFIER
,@SiteGuid UNIQUEIDENTIFIER
,@PageNumber    INT
,@PageSize      INT
,@SortDirection VARCHAR(4)
AS
SELECT
TOP (@PageSize) *
FROM
(
SELECT
RowID     = ROW_NUMBER() OVER (ORDER BY ms.[GlobalSort], i.[SortOrder])
, TotalRows = Count(*) OVER ()
, i.*
, ms.GlobalSort AS [GlobalSort]
FROM
[dbo].[i7_sflexi_items] i
JOIN	   (
select SettingName, SettingValue AS [GlobalSort], ModuleGuid
from [dbo].[mp_ModuleSettings]
where SettingName = 'GlobalViewSortOrder'
) ms on ms.ModuleGuid = i.ModuleGuid
WHERE
i.[DefinitionGuid] = @DefGuid
AND i.[SiteGuid]   = @SiteGuid
)
a
WHERE
a.RowID > ((@PageNumber - 1) * @PageSize)
ORDER BY
CASE WHEN @SortDirection = 'DESC' THEN  [GlobalSort] END DESC
,CASE WHEN @SortDirection = 'ASC' THEN  [GlobalSort] END
,CASE WHEN @SortDirection = 'DESC' THEN  [SortOrder] END DESC
,CASE WHEN @SortDirection = 'ASC' THEN  [SortOrder] END


/********************************************************************
END ALTER SelectPageForDefinition
********************************************************************/
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
/********************************************************************
	ALTER SelectPageForDefinitionWithTerm
********************************************************************/
CREATE PROCEDURE [dbo].[i7_sflexi_items_SelectPageForDefinitionWithTerm]
@DefGuid UNIQUEIDENTIFIER
,@PageNumber    INT
,@PageSize      INT
,@SearchTerm    NVARCHAR(max)
,@SortDirection VARCHAR(4)
,@SiteGuid UNIQUEIDENTIFIER
AS
    SELECT
             TOP (@PageSize) *
    FROM
             (
                      SELECT
                               RowID     = ROW_NUMBER() OVER (ORDER BY i.[SortOrder])
                             , TotalRows = Count(*) OVER ()
                             , i.*
                             , v.FieldValue
                             , f.Name AS FieldName
                             , v.FieldGuid
                      FROM
                               [dbo].[i7_sflexi_items] i
                               JOIN
                                        (
                                               SELECT DISTINCT
                                                      ItemGuid
                                                    , FieldValue
                                                    , FieldGuid
                                               FROM
                                                      [dbo].[i7_sflexi_values]
                                               WHERE
                                                      FieldValue LIKE '%' + @SearchTerm + '%'
                                        )
                                        v
                                        ON
                                                 v.ItemGuid = i.ItemGuid
                               JOIN
                                        [dbo].[i7_sflexi_fields] f
                                        ON
                                                 f.FieldGuid = v.FieldGuid
                      WHERE
                               i.[DefinitionGuid] = @DefGuid
                               AND i.[SiteGuid]   = @SiteGuid
             )
             a
    WHERE
             a.RowID > ((@PageNumber - 1) * @PageSize)
    ORDER BY
             CASE
                      WHEN @SortDirection = 'DESC'
                               THEN [SortOrder]
             END DESC
           , CASE
                      WHEN @SortDirection = 'ASC'
                               THEN [SortOrder]
             END 
/********************************************************************
	END ALTER SelectPageForDefinitionWithTerm
********************************************************************/
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
/********************************************************************
	ALTER SelectPageForDefinitionWithTermAndField
********************************************************************/
CREATE PROCEDURE [dbo].[i7_sflexi_items_SelectPageForDefinitionWithTermAndField] 
@DEFGuid UNIQUEIDENTIFIER
,@PageNumber    INT
,@PageSize      INT
,@SearchTerm    NVARCHAR(max)
,@SearchField   NVARCHAR(max)
,@SortDirection VARCHAR(4)
,@SiteGuid UNIQUEIDENTIFIER
AS
    SELECT
             TOP (@PageSize) *
    FROM
             (
                      SELECT
                               RowID     = Row_number() OVER ( ORDER BY i.[SortOrder])
                             , TotalRows = Count(*) OVER ()
                             , i.*
                             , v.FieldValue
                             , f.FieldName
                             , v.FieldGuid
                      FROM
                               [dbo].[i7_sflexi_items] i
                               JOIN
                                        (
                                               SELECT DISTINCT
                                                      ItemGuid
                                                    , FieldGuid
                                                    , FieldValue
                                               FROM
                                                      [dbo].[i7_sflexi_values]
                                               WHERE
                                                      FieldValue LIKE '%' + @SearchTerm + '%'
                                        )
                                        v
                                        ON
                                                 v.ItemGuid = i.ItemGuid
                               JOIN
                                        (
                                               SELECT DISTINCT
                                                                FieldGuid
                                                    , [Name] AS FieldName
                                               FROM
                                                      [dbo].[i7_sflexi_fields]
                                               WHERE
                                                      Name               = @SearchField
                                                      AND DefinitionGuid = @DefGuid
                                        )
                                        f
                                        ON
                                                 f.FieldGuid = v.FieldGuid
                      WHERE
                               i.[DefinitionGuid] = @DefGuid
                               AND i.[SiteGuid]   = @SiteGuid
             )
             a
    WHERE
             a.RowID > ( ( @PageNumber - 1 ) * @PageSize )
    ORDER BY
             CASE
                      WHEN @SortDirection = 'DESC'
                               THEN [SortOrder]
             END DESC
           , CASE
                      WHEN @SortDirection = 'ASC'
                               THEN [SortOrder]
             END 
/********************************************************************
	END ALTER SelectPageForDefinitionWithTermAndField
********************************************************************/
GO


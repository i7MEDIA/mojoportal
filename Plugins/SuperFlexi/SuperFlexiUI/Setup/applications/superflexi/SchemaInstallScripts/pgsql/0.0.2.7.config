SET check_function_bodies = false;

CREATE SEQUENCE public.i7_sflexi_items_itemid_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;
CREATE SEQUENCE public.i7_sflexi_values_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;

CREATE TABLE public.i7_sflexi_fields (
    siteguid uuid NOT NULL,
    featureguid uuid NOT NULL,
    definitionguid uuid NOT NULL,
    fieldguid uuid NOT NULL,
    definitionname character varying(50),
    name character varying(50),
    label character varying(255),
    defaultvalue text,
    controltype character varying(25),
    controlsrc text,
    sortorder integer,
    helpkey character varying(255),
    required boolean,
    requiredmessageformat text,
    regex text,
    regexmessageformat text NOT NULL,
    token character varying(50),
    searchable boolean,
    editpagecontrolwrappercssclass character varying(50),
    editpagelabelcssclass character varying(50),
    editpagecontrolcssclass character varying(50),
    datepickerincludetimefordate boolean,
    datepickershowmonthlist boolean,
    datepickershowyearlist boolean,
    datepickeryearrange character varying(10),
    imagebrowseremptyurl text,
    options text,
    checkboxreturnbool boolean,
    checkboxreturnvaluewhentrue text,
    checkboxreturnvaluewhenfalse text,
    dateformat text,
    textboxmode character varying(25),
    attributes text,
    isdeleted boolean DEFAULT false,
    pretokenstring text,
    posttokenstring text,
    isglobal boolean,
    viewroles text NOT NULL,
    editroles text NOT NULL,
    pretokenstringwhentrue text NOT NULL,
    posttokenstringwhentrue text NOT NULL,
    pretokenstringwhenfalse text NOT NULL,
    posttokenstringwhenfalse text NOT NULL,
    datatype character varying(100) DEFAULT 'string'::character varying,
    islist boolean DEFAULT false
);

CREATE TABLE public.i7_sflexi_items (
    siteguid uuid NOT NULL,
    featureguid uuid NOT NULL,
    moduleguid uuid NOT NULL,
    moduleid integer NOT NULL,
    definitionguid uuid NOT NULL,
    itemguid uuid NOT NULL,
    itemid bigint NOT NULL,
    sortorder integer NOT NULL,
    createdutc timestamp without time zone NOT NULL,
    lastmodutc timestamp without time zone NOT NULL,
    viewroles text DEFAULT 'All Users;'::text NOT NULL,
    editroles text DEFAULT ''::text NOT NULL
);

ALTER SEQUENCE public.i7_sflexi_items_itemid_seq OWNED BY public.i7_sflexi_items.itemid;

CREATE TABLE public.i7_sflexi_searchdefs (
    guid uuid NOT NULL,
    siteguid uuid NOT NULL,
    featureguid uuid NOT NULL,
    fielddefinitionguid uuid NOT NULL,
    title text NOT NULL,
    keywords text NOT NULL,
    description text NOT NULL,
    link text NOT NULL,
    linkqueryaddendum text NOT NULL
);

CREATE TABLE public.i7_sflexi_values (
    id bigint NOT NULL,
    valueguid uuid NOT NULL,
    siteguid uuid NOT NULL,
    featureguid uuid NOT NULL,
    moduleguid uuid NOT NULL,
    itemguid uuid NOT NULL,
    fieldguid uuid NOT NULL,
    fieldvalue text NOT NULL
);

ALTER SEQUENCE public.i7_sflexi_values_id_seq OWNED BY public.i7_sflexi_values.id;

ALTER TABLE ONLY public.i7_sflexi_items ALTER COLUMN itemid SET DEFAULT nextval('public.i7_sflexi_items_itemid_seq'::regclass);

ALTER TABLE ONLY public.i7_sflexi_values ALTER COLUMN id SET DEFAULT nextval('public.i7_sflexi_values_id_seq'::regclass);

SELECT pg_catalog.setval('public.i7_sflexi_items_itemid_seq', 1, false);

SELECT pg_catalog.setval('public.i7_sflexi_values_id_seq', 1, false);

ALTER TABLE ONLY public.i7_sflexi_fields
    ADD CONSTRAINT i7_sflexi_fields_pkey PRIMARY KEY (fieldguid);

ALTER TABLE ONLY public.i7_sflexi_items
    ADD CONSTRAINT i7_sflexi_items_itemguid_key UNIQUE (itemguid);

ALTER TABLE ONLY public.i7_sflexi_items
    ADD CONSTRAINT i7_sflexi_items_pkey PRIMARY KEY (itemid, itemguid);

ALTER TABLE ONLY public.i7_sflexi_searchdefs
    ADD CONSTRAINT i7_sflexi_searchdefs_pkey PRIMARY KEY (guid);

ALTER TABLE ONLY public.i7_sflexi_values
    ADD CONSTRAINT i7_sflexi_values_pkey PRIMARY KEY (id);

ALTER TABLE ONLY public.i7_sflexi_values
    ADD CONSTRAINT i7_sflexi_values_valueguid_key UNIQUE (valueguid);

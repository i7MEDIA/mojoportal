DROP INDEX IF EXISTS public.ix_mp_htmlcontent_moduleid_begindate_enddate_lastmoduserguid_us;
CREATE INDEX ix_mp_htmlcontent_moduleid_begindate_enddate_lastmoduserguid_us ON public.mp_htmlcontent USING btree (moduleid, begindate, enddate, lastmoduserguid, userguid);

DROP INDEX IF EXISTS public.ix_mp_moduledefinitionsettings_moduledefid_id;
CREATE INDEX ix_mp_moduledefinitionsettings_moduledefid_id ON public.mp_moduledefinitionsettings USING btree (moduledefid, id);

DROP INDEX IF EXISTS public.mp_modulesettings_ix_modul_0;
DROP INDEX IF EXISTS public.ix_mp_modulesettings_moduleid_settingname;
CREATE INDEX ix_mp_modulesettings_moduleid_settingname ON public.mp_modulesettings USING btree (moduleid, settingname);

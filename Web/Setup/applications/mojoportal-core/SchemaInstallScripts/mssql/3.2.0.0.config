CREATE PROCEDURE [dbo].[mp_Roles_RoleExists]

/*
Author:			
Created:		5/19/2005
Last Modified:		5/19/2005

*/
    
@SiteID  	int,
@RoleName	nvarchar(50)

AS

IF EXISTS (	SELECT 	RoleID
		FROM		mp_Roles
		WHERE	SiteID = @SiteID
				AND (RoleName = @RoleName OR DisplayName = @RoleName))
SELECT 1
ELSE
SELECT 0
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
CREATE PROCEDURE [dbo].[mp_Roles_Select]


@SiteID  int

AS

SELECT
r.[RoleID],
r.[SiteID],
r.[RoleName],
r.[DisplayName],
r.[SiteGuid],
r.[RoleGuid],
r.[Description],
COUNT(ur.[UserID]) AS [MemberCount]

FROM		[dbo].[mp_Roles] r

LEFT OUTER JOIN [dbo].[mp_UserRoles] ur
ON		ur.[RoleID] = r.[RoleID]

WHERE   	r.[SiteID] = @SiteID

GROUP BY
r.[RoleID],
r.[SiteID],
r.[RoleName],
r.[DisplayName],
r.[SiteGuid],
r.[RoleGuid],
r.[Description]

ORDER BY r.[DisplayName]
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

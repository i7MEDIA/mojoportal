CREATE PROCEDURE [dbo].[mp_UserLocation_SelectUsersByIP]

/*
Author:   			
Created: 			2009-02-27
Last Modified: 		2009-02-27
*/

@SiteGuid uniqueidentifier,
@IPAddress nvarchar(50)

AS


SELECT
		u.*
		
FROM
		[dbo].[mp_UserLocation] ul

JOIN	[dbo].[mp_Users] u
ON ul.UserGuid = u.UserGuid
		
WHERE

	ul.[IPAddress] = @IPAddress

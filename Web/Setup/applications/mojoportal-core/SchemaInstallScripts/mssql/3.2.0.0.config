CREATE PROCEDURE [dbo].[mp_Pages_CleanupOrphans]

AS

UPDATE mp_Pages

SET ParentGuid = '00000000-0000-0000-0000-000000000000',
	ParentID = -1

WHERE ParentID <> -1
AND ParentID NOT IN (SELECT PageID FROM mp_Pages)

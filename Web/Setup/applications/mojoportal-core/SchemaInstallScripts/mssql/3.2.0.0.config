/*
Author:   			
Created: 			2007-12-29
Last Modified: 		2007-12-29
*/
	
@Guid uniqueidentifier,  
@StartUTC datetime, 
@CompleteUTC datetime, 
@LastStatusUpdateUTC datetime, 
@CompleteRatio float, 
@Status nvarchar(255)


AS

UPDATE 		[dbo].[mp_TaskQueue] 

SET
			
			[StartUTC] = @StartUTC,
			[CompleteUTC] = @CompleteUTC,

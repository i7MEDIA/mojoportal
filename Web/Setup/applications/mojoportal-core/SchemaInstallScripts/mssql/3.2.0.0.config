CREATE PROCEDURE [dbo].[mp_ModuleDefinitionSettings_Update]
	@ModuleDefID int,
	@SettingName nvarchar(50),
	@SettingValue nvarchar(max),
	@ControlType nvarchar(50),
	@RegexValidationExpression nvarchar(max),
	@FeatureGuid uniqueidentifier,
	@ResourceFile nvarchar(255),
	@ControlSrc	nvarchar(255),
	@HelpKey nvarchar(255),
	@SortOrder int,
	@GroupName nvarchar(255),
	@Attributes ntext,
	@Options ntext,
	@Roles nvarchar(255),
	@ShowToUnauthorized bit
AS
BEGIN
	IF NOT EXISTS (
		SELECT *
		FROM [dbo].[mp_ModuleDefinitionSettings] 
		WHERE ([ModuleDefID] = @ModuleDefID OR [FeatureGuid] = @FeatureGuid)
		AND [SettingName] = @SettingName
	)
	BEGIN
		INSERT INTO [dbo].[mp_ModuleDefinitionSettings] (
			FeatureGuid,
			ModuleDefID,
			ResourceFile,
			SettingName,
			SettingValue,
			ControlType,
			RegexValidationExpression,
			ControlSrc,
			HelpKey,
			SortOrder,
			GroupName,
			Attributes,
			Options,
			Roles,
			ShowToUnauthorized
		) 
		VALUES (
			@FeatureGuid,
			@ModuleDefID,
			@ResourceFile,
			@SettingName,
			@SettingValue,
			@ControlType,
			@RegexValidationExpression,
			@ControlSrc,
			@HelpKey,
			@SortOrder,
			@GroupName,
			@Attributes,
			@Options,
			@Roles,
			@ShowToUnauthorized
		)
	END

	ELSE
	BEGIN
		UPDATE [dbo].[mp_ModuleDefinitionSettings]
		SET
			[FeatureGuid] = @FeatureGuid,
			[SettingValue] = @SettingValue,
			[ControlType] = @ControlType,
			[RegexValidationExpression] = @RegexValidationExpression,
			[ResourceFile] = @ResourceFile,
			[ControlSrc] = @ControlSrc,
			[HelpKey] = @HelpKey,
			[SortOrder] = @SortOrder,
			[GroupName] = @GroupName,
			[Attributes] = @Attributes,
			[Options] = @Options,
			[Roles] = @Roles,
			[ShowToUnauthorized] = @ShowToUnauthorized
		WHERE ([ModuleDefID] = @ModuleDefID OR [FeatureGuid] = @FeatureGuid)
		AND [SettingName] = @SettingName
	END
END
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_ModuleDefinitionSettings_UpdateByID]
	@ID int,
	@ModuleDefID int,

CREATE PROCEDURE [dbo].[mp_Users_EmailLookup]

@SiteID			int,
@Query				nvarchar(50),
@RowsToGet			int


AS


SET ROWCOUNT @RowsToGet


SELECT 		u1.UserID,
			u1.UserGuid,
			u1.Email

FROM			mp_Users u1

WHERE		u1.SiteID = @SiteID
			AND u1.IsDeleted = 0
			AND (
			 (LOWER(u1.[Email]) LIKE LOWER(@Query) + '%')
			OR (LOWER(u1.[Name]) LIKE LOWER(@Query) + '%')
			OR (LOWER(u1.[FirstName]) LIKE LOWER(@Query) + '%')
			OR (LOWER(u1.[LastName]) LIKE LOWER(@Query) + '%')
			)



ORDER BY	u1.Email
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO

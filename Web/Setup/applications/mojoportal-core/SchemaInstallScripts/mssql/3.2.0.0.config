CREATE PROCEDURE [dbo].[mp_ContentHistory_SelectByContent]

/*
Author:   			
Created: 			2009-03-31
Last Modified: 		2009-03-31
*/

@ContentGuid uniqueidentifier

AS


SELECT ch.*,
		u.[Name],
		u.LoginName,
		u.Email
		
FROM
		[dbo].[mp_ContentHistory] ch
LEFT OUTER JOIN
		[dbo].[mp_Users] u
ON
		u.UserGuid = ch.UserGuid
		
WHERE
		ch.[ContentGuid] = @ContentGuid
		
ORDER BY
		HistoryUtc DESC
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

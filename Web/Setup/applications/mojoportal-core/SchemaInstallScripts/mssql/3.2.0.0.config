CREATE Procedure [dbo].[mp_UserRoles_Insert]
(
@RoleID int,
@UserID int,
@RoleGuid	uniqueidentifier,
@UserGuid	uniqueidentifier
    
)
AS

IF NOT EXISTS (SELECT RoleID FROM mp_UserRoles
WHERE UserID = @UserID AND RoleID = @RoleID)
BEGIN
INSERT INTO mp_UserRoles
    (
        UserID,
        RoleID,
		RoleGuid,
		UserGuid
    )

    VALUES
    (
        @UserID,
        @RoleID,
		@RoleGuid,
		@UserGuid
    )
END
GO


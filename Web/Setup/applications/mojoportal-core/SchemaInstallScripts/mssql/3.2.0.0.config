CREATE PROCEDURE [dbo].[mp_TagItem_GetByExtra] 

@ExtraGuid uniqueidentifier,
@SiteGuid uniqueidentifier

AS

SELECT 
	ti.[TagItemGuid],
	ti.[RelatedItemGuid],
	ti.[SiteGuid],
	ti.[FeatureGuid],
	ti.[ModuleGuid],
	ti.[TagGuid],
	ti.[ExtraGuid],
	ti.[TaggedBy],
	t.[Tag] AS [TagText]
FROM [dbo].[mp_TagItem] ti
INNER JOIN [dbo].[mp_Tag] t
ON ti.[TagGuid] = t.[Guid]
WHERE ti.[ExtraGuid] = @ExtraGuid
AND ti.[SiteGuid] = @SiteGuid
ORDER BY [TagText]
GO


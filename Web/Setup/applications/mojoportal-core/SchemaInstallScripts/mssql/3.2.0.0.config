CREATE Procedure [dbo].[mp_ContentWorkflow_SelectPage]
	@SiteGuid uniqueidentifier,
	@Status nvarchar(20),
	@PageNumber int,
	@PageSize int
AS
BEGIN
	DECLARE @PageLowerBound int = (@PageSize * @PageNumber) - @PageSize;
	DECLARE @PageUpperBound int= @PageLowerBound + @PageSize + 1;

	CREATE TABLE #PageIndex 
	(
		[IndexID] int IDENTITY (1, 1) NOT NULL,
		[Guid] UniqueIdentifier
	);

	BEGIN
		INSERT INTO #PageIndex ([Guid])
		SELECT [Guid]
		FROM [dbo].[mp_ContentWorkflow]
		WHERE SiteGuid = @SiteGuid
		AND [Status] = @Status
		ORDER BY [CreatedDateUtc] DESC
	END

	SELECT
		cw.*,
		m.[ModuleID],
		m.[ModuleTitle],
		COALESCE(createdBy.[Name], 'Deleted user') as [CreatedByUserName],
		COALESCE(createdBy.[LoginName], 'deleted') as [CreatedByUserLogin],
		COALESCE(createdBy.[Email], 'deleted@user.com') as [CreatedByUserEmail],
		cwah.[Notes] as [Notes],
		cwah.[CreatedDateUtc] as [RecentActionOn],
		COALESCE(recentActionBy.[Name], 'Deleted user') as [RecentActionByUserName],
		COALESCE(recentActionBy.[LoginName], 'deleted') as [RecentActionByUserLogin],
		COALESCE(recentActionBy.[Email], 'deleted@user.com') as [RecentActionByUserEmail]
	FROM [dbo].[mp_ContentWorkflow] cw
	JOIN #PageIndex idx ON cw.[Guid] = idx.[Guid]
	JOIN [dbo].[mp_Modules] m ON cw.[ModuleGuid] = m.[Guid]
	LEFT OUTER JOIN [dbo].[mp_Users] createdBy ON createdBy.[UserGuid] = cw.[UserGuid]
	LEFT OUTER JOIN [dbo].[mp_ContentWorkflowAuditHistory] cwah ON cwah.[ContentWorkflowGuid] = cw.[Guid] AND cwah.[Active] = 1
	LEFT OUTER JOIN [dbo].[mp_Users] recentActionBy ON recentActionBy.[UserGuid] = cwah.[UserGuid]
	WHERE idx.[IndexID] > @PageLowerBound
	AND idx.[IndexID] < @PageUpperBound
	ORDER BY idx.[IndexID];

	DROP TABLE #PageIndex;
END
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_ContentWorkflow_SelectPageInfoForPage]


/*
Author:   			
Created: 			2009-07-20
Last Modified: 		2009-07-20
*/

@SiteGuid	uniqueidentifier,
@Status		nvarchar(20),
@PageNumber 			int,
@PageSize 			int

AS

DECLARE @PageLowerBound int
DECLARE @PageUpperBound int


SET @PageLowerBound = (@PageSize * @PageNumber) - @PageSize
SET @PageUpperBound = @PageLowerBound + @PageSize + 1



CREATE TABLE #PageIndex 
(
	IndexID int IDENTITY (1, 1) NOT NULL,
[Guid] UniqueIdentifier
)

BEGIN

INSERT INTO #PageIndex ( 
Guid
)

SELECT
		[Guid]
		
FROM
		[dbo].[mp_ContentWorkflow]		
WHERE
		SiteGuid = @SiteGuid
AND		[Status] = @Status

ORDER BY
		CreatedDateUtc DESC

END


SELECT
		p.PageID,
		p.PageGuid,
		p.PageName,
		p.UseUrl,
		p.Url As PageUrl,
		cw.[Guid] As WorkflowGuid
		
		
FROM
		[dbo].[mp_ContentWorkflow] cw

JOIN	#PageIndex idx
ON			
		cw.[Guid] = idx.[Guid]
		
JOIN    [dbo].mp_Modules m
ON
		cw.ModuleGuid = m.[Guid]
		
JOIN
		[dbo].[mp_PageModules] pm
ON
		pm.ModuleID = m.ModuleID
		
JOIN
		[dbo].[mp_Pages] p
ON	
		pm.PageID = p.PageID


WHERE
		idx.IndexID > @PageLowerBound 
		AND idx.IndexID < @PageUpperBound
		
ORDER BY idx.IndexID

DROP TABLE #PageIndex
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE Procedure [dbo].[mp_ContentWorkflow_SelectWorkInProgress]

/*
Author:   			Kevin Needham
Created: 			2009-06-19
Last Modified: 		2012-10-31
*/

@ModuleGuid uniqueidentifier
As

SELECT	cw.*,
		m.ModuleTitle,
		m.ModuleID,
		createdBy.[Name] as CreatedByUserName,
		createdBy.FirstName as CreatedByFirstName,
		createdBy.LastName as CreatedByLastName,
		createdBy.LoginName as CreatedByUserLogin,
		createdBy.Email as CreatedByUserEmail,
		createdBy.UserID as CreatedByUserID,
		createdBy.AvatarUrl as CreatedByAvatar,
		createdBy.AuthorBio as CreatedByAuthorBio,
		
		modifiedBy.[Name] as ModifiedByUserName,
		modifiedBy.FirstName as ModifiedByFirstName,
		modifiedBy.LastName as ModifiedByLastName,
		modifiedBy.LoginName as ModifiedByUserLogin,
		modifiedBy.Email as ModifiedByUserEmail,
		
		
		cwah.Notes as Notes,
		cwah.CreatedDateUtc as RecentActionOn,
		recentActionBy.[Name] as RecentActionByUserName,
		recentActionBy.LoginName as RecentActionByUserLogin,
		recentActionBy.Email as RecentActionByUserEmail		
				
FROM
		[dbo].[mp_ContentWorkflow] cw
		
JOIN    [dbo].mp_Modules m
ON
		cw.ModuleGuid = m.[Guid]
		
LEFT OUTER JOIN
		[dbo].[mp_Users] createdBy
ON
		createdBy.UserGuid = cw.UserGuid
		
LEFT OUTER JOIN
		[dbo].[mp_Users] modifiedBy
ON
		modifiedBy.UserGuid = cw.LastModUserGuid
		
LEFT OUTER JOIN
		[dbo].[mp_ContentWorkflowAuditHistory] cwah
ON	
		cwah.ContentWorkflowGuid = cw.[Guid]
AND		cwah.Active = 1		

LEFT OUTER JOIN
		[dbo].[mp_Users] recentActionBy
ON
		recentActionBy.UserGuid = cwah.UserGuid
		
WHERE
		cw.[ModuleGuid] = @ModuleGuid
AND		 cw.[Status] Not In ('Cancelled','Approved')
		
ORDER BY
		cw.CreatedDateUtc DESC
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE Procedure [dbo].[mp_ContentWorkflow_SelectWorkInProgressByStatus]

/*
Author:   			
Created: 			2009-07-18
Last Modified: 		2012-10-31
*/

@ModuleGuid uniqueidentifier,
@Status nvarchar(20)

As

SELECT	cw.*,
		m.ModuleID,
		m.ModuleTitle,
		createdBy.[Name] as CreatedByUserName,
		createdBy.FirstName as CreatedByFirstName,
		createdBy.LastName as CreatedByLastName,
		createdBy.LoginName as CreatedByUserLogin,
		createdBy.Email as CreatedByUserEmail,
		createdBy.UserID as CreatedByUserID,
		createdBy.AvatarUrl as CreatedByAvatar,
		createdBy.AuthorBio as CreatedByAuthorBio,
		
		modifiedBy.[Name] as ModifiedByUserName,
		modifiedBy.FirstName as ModifiedByFirstName,
		modifiedBy.LastName as ModifiedByLastName,
		modifiedBy.LoginName as ModifiedByUserLogin,
		modifiedBy.Email as ModifiedByUserEmail,
		
		
		cwah.Notes as Notes,
		cwah.CreatedDateUtc as RecentActionOn,
		recentActionBy.[Name] as RecentActionByUserName,
		recentActionBy.LoginName as RecentActionByUserLogin,
		recentActionBy.Email as RecentActionByUserEmail		
				
FROM
		[dbo].[mp_ContentWorkflow] cw
		
JOIN    [dbo].mp_Modules m
ON
		cw.ModuleGuid = m.[Guid]
		
LEFT OUTER JOIN
		[dbo].[mp_Users] createdBy
ON
		createdBy.UserGuid = cw.UserGuid
		
LEFT OUTER JOIN
		[dbo].[mp_Users] modifiedBy
ON
		modifiedBy.UserGuid = cw.LastModUserGuid
		
LEFT OUTER JOIN
		[dbo].[mp_ContentWorkflowAuditHistory] cwah
ON	
		cwah.ContentWorkflowGuid = cw.[Guid]
AND		cwah.Active = 1		

LEFT OUTER JOIN
		[dbo].[mp_Users] recentActionBy
ON
		recentActionBy.UserGuid = cwah.UserGuid
		
WHERE
		cw.[ModuleGuid] = @ModuleGuid
AND		 cw.[Status] = @Status
		
ORDER BY
		cw.CreatedDateUtc DESC
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

WHERE		SiteID = @SiteID
			AND FriendlyUrl LIKE '%' + @SearchTerm + '%'

ORDER BY	FriendlyUrl

END



SELECT
		t1.*
		
FROM
		[dbo].[mp_FriendlyUrls] t1

JOIN			#PageIndex t2
ON			
		t1.[UrlID] = t2.[UrlID]
		
WHERE
		t2.IndexID > @PageLowerBound 
		AND t2.IndexID < @PageUpperBound
		
ORDER BY t2.IndexID

DROP TABLE #PageIndex

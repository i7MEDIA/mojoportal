*/

AS


SELECT
		[RowGuid],
		[CreatedUtc],
		[SiteGuid],
		[UserGuid],
		[StoreGuid],
		[CartGuid],
		[RawResponse],
		[ResponseCode],
		[ResponseReasonCode],
		[Reason],
		[AvsCode],
		[CcvCode],
		[CavCode],
		[TransactionId],

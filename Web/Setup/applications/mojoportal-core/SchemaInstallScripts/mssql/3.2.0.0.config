CREATE PROCEDURE [dbo].[mp_UserRoles_CountInRole]

-- Author:   			
-- Created: 			2012-01-06
-- Last Modified: 		2012-01-06

@SiteID	int,
@RoleID  int

AS


SELECT  COUNT(DISTINCT u.UserID)

FROM		[dbo].mp_Users  u
    		
    
JOIN 		
		[dbo].mp_UserRoles ur

ON 		u.UserID = ur.UserID
		AND ur.RoleID = @RoleID

WHERE		u.SiteID = @SiteID

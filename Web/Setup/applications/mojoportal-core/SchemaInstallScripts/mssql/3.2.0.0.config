CREATE PROCEDURE [dbo].[mp_Users_UpdateTotalRevenue]


AS

UPDATE mp_Users 
SET TotalRevenue = COALESCE((
SELECT SUM(SubTotal) FROM mp_CommerceReport WHERE UserGuid = mp_Users.UserGuid)
, 0)
GO


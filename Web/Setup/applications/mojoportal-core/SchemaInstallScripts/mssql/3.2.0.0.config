CREATE PROCEDURE [dbo].[mp_LetterSubscribe_SelectPage]

-- Author:   			
-- Created: 			2009-10-11
-- Last Modified: 		2013-08-23

@LetterInfoGuid			uniqueidentifier,
@PageNumber 			int,
@PageSize 			int

AS

DECLARE @PageLowerBound int
DECLARE @PageUpperBound int


SET @PageLowerBound = (@PageSize * @PageNumber) - @PageSize
SET @PageUpperBound = @PageLowerBound + @PageSize + 1

CREATE TABLE #PageIndex 
(
	IndexID int IDENTITY (1, 1) NOT NULL,
[Guid] uniqueidentifier
)

BEGIN

INSERT INTO #PageIndex ( 
[Guid]
)

SELECT
		ls.[Guid]
		
FROM
		[dbo].[mp_LetterSubscribe] ls

LEFT OUTER JOIN		[dbo].mp_Users u
ON		ls.UserGuid = u.UserGuid
		
WHERE		ls.[LetterInfoGuid] = @LetterInfoGuid

ORDER BY	ls.BeginUtc DESC

END



SELECT
		t1.[Guid],
		t1.[SiteGuid],
		t1.[LetterInfoGuid],
		t1.[UserGuid],
		t1.[IsVerified],
		t1.[VerifyGuid],
		t1.[BeginUtc],
		t1.[UseHtml],
		t1.[IpAddress],
		COALESCE(u.Email, t1.[Email]) As Email,
		COALESCE(u.[Name], t1.[Email]) As [Name],
		u.[Email] As UserEmail,
		u.FirstName,
		u.LastName
		
FROM
		[dbo].[mp_LetterSubscribe] t1
		
LEFT OUTER JOIN		[dbo].mp_Users u
ON		t1.UserGuid = u.UserGuid

JOIN			#PageIndex t2
ON			
		t1.[Guid] = t2.[Guid]
		
WHERE
		t2.IndexID > @PageLowerBound 
		AND t2.IndexID < @PageUpperBound
		
ORDER BY t2.IndexID

DROP TABLE #PageIndex
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[mp_LetterSubscribe_SelectUnsentByLetter]

/*
Author:   			
Created: 			2009-10-11
Last Modified: 		2012-11-05
*/

@LetterGuid uniqueidentifier,
@LetterInfoGuid uniqueidentifier

AS


SELECT
		ls.[Guid],
		ls.[SiteGuid],
		ls.[LetterInfoGuid],
		ls.[UserGuid],
		ls.[IsVerified],
		ls.[VerifyGuid],
		ls.[BeginUtc],
		ls.[UseHtml],
		ls.[IpAddress],
		COALESCE(u.Email, ls.[Email]) As Email,
		u.[Name],
		u.FirstName,
		u.LastName
		
FROM
		[dbo].[mp_LetterSubscribe] ls

LEFT OUTER JOIN
		[dbo].[mp_Users] u
ON		
		u.[UserGuid] = ls.[UserGuid]
		
WHERE
		ls.[LetterInfoGuid] = @LetterInfoGuid
		AND ls.IsVerified = 1
		AND ls.[Guid] NOT IN ( SELECT [SubscribeGuid]
									FROM	[dbo].[mp_LetterSendLog]
									WHERE [LetterGuid] = @LetterGuid )

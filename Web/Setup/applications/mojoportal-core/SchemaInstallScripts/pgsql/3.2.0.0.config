CREATE OR REPLACE FUNCTION public.mp_modulesettings_selectsettings(integer)
 RETURNS SETOF mp_modulesettings_select_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select distinct	ms.id,
	ms.moduleid,
	ms.settingname,
	ms.settingvalue,
	ms.controltype,
	ms.controlsrc,
	ms.helpkey,
	ms.sortorder,
	ms.regexvalidationexpression,
	mds.featureguid,
	mds.resourcefile
		
from		mp_modulesettings ms

join		mp_modules m
on			ms.moduleid = m.moduleid

join		mp_moduledefinitionsettings mds
on		m.moduledefid = mds.moduledefid
		AND mds.settingname = ms.settingname

where	m.moduleid = $1
order by ms.sortorder
; $function$
;
CREATE OR REPLACE FUNCTION public.mp_modulesettings_update(integer, character varying, character varying, character, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_settingname alias for $2;
	_settingvalue alias for $3;
	_settingguid alias for $4;
	_moduleguid alias for $5;
	t_found int4;
	_rowcount int4;
begin

select into t_found 1 from 
        mp_modulesettings 
    where 
        moduleid = _moduleid
      and
        settingname = _settingname limit 1;

if not found then
	insert into mp_modulesettings (
	    moduleguid,
	    settingguid,
	    moduleid,
	    settingname,
	    settingvalue
	) 
	values (
	    _moduleguid,
	    _settingguid,
	    _moduleid,
	    _settingname,
	    _settingvalue
	);
else
	update
	    mp_modulesettings
	set
	    settingvalue = _settingvalue
	where
	    moduleid = _moduleid
	  and
	    settingname = _settingname;   
end if;
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

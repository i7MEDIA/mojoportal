CREATE OR REPLACE FUNCTION public.mp_sitepersonalizationallusers_insert(character varying, bytea, timestamp without time zone)
 RETURNS boolean
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
insert into 		mp_sitepersonalizationallusers
(
			pathid,
    			pagesettings,
    			lastupdate
    		
)
values
(
			$1,

CREATE OR REPLACE FUNCTION public.mp_modules_selectbypageid(integer, timestamp without time zone)
 RETURNS SETOF mp_modules_selectbypageid_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  		
			m.moduleid ,
			pm.pageid ,
			m.moduledefid ,
			pm.moduleorder ,
			pm.panename ,
			m.moduletitle ,
			m.authorizededitroles ,
			m.cachetime ,
			m.showtitle ,
			m.hidefromauth,
			m.hidefromunauth,
			md.controlsrc,
			m.edituserid,
			m.availableformypage,
			m.createdbyuserid,
			m.createddate,
			pm.publishbegindate,
			pm.publishenddate,
			m.guid,
			m.featureguid,
			m.siteguid,
         		m.edituserguid
    
from
    			mp_modules m
  
inner join
    			mp_moduledefinitions md
on 			m.moduledefid = md.moduledefid

inner join		mp_pagemodules pm
on			pm.moduleid = m.moduleid
    
where   
    			pm.pageid = $1
    			AND pm.publishbegindate < $2
    			AND (pm.publishenddate IS NULL OR pm.publishenddate > $2)
		
    
order by
    			pm.moduleorder; $function$
;
CREATE OR REPLACE FUNCTION public.mp_modules_selectformypage(integer)
 RETURNS SETOF mp_modules_selectformypage_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  		
			m.moduleid ,
			m.siteid ,
			m.moduledefid ,
			m.moduletitle ,
			m.allowmultipleinstancesonmypage,
			m.icon as moduleicon,
			md.icon as featureicon,
			md.featurename
    
from
    			mp_modules m
  
inner join
    			mp_moduledefinitions md
on 			m.moduledefid = md.moduledefid
    
where   
    			m.siteid = $1 and m.availableformypage = true
		
    
order by
    			m.moduletitle; $function$
;
CREATE OR REPLACE FUNCTION public.mp_modules_selectone(integer)
 RETURNS SETOF mp_modules_selectone_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select
         moduleid,
	 siteid,
	 moduledefid,
	 moduletitle,
	 authorizededitroles,
	 cachetime,
	 showtitle,
	 hidefromauth,
	 hidefromunauth,
	 edituserid,
	 availableformypage,
	 allowmultipleinstancesonmypage,
	 icon,
	 createdbyuserid,
	 createddate,
	 countofuseonmypage,
	 guid,
	 featureguid,
	 siteguid,
        edituserguid
		
from
		mp_modules
		
where
		moduleid = $1; $function$
;
CREATE OR REPLACE FUNCTION public.mp_modules_selectonebypage(integer, integer)
 RETURNS SETOF mp_modules_selectonebypage_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select
         m.moduleid ,
         m.siteid,
         pm.pageid ,
         m.moduledefid ,
         pm.moduleorder ,
         pm.panename ,
         m.moduletitle ,
         m.authorizededitroles ,
         m.cachetime ,
         m.showtitle ,
         m.hidefromauth,
         m.hidefromunauth,
         m.edituserid,
         m.availableformypage,
         m.allowmultipleinstancesonmypage,
         m.countofuseonmypage,
         m.icon,
         m.createdbyuserid,
         m.createddate,
         pm.publishbegindate,
         pm.publishenddate,
         md.controlsrc,
         m.guid,
         m.featureguid,
         m.siteguid,
         m.edituserguid
		
from
		mp_modules m
join		mp_moduledefinitions md
on		md.moduledefid = m.moduledefid

join		mp_pagemodules pm
on		m.moduleid = pm.moduleid
		
where		
		pm.moduleid = $1 AND pm.pageid = $2; $function$
;
CREATE OR REPLACE FUNCTION public.mp_modules_selectpage(integer, integer, integer, boolean, boolean)
 RETURNS SETOF mp_modules_selectpage_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_siteid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_sortbymoduletype alias for $4;
	_sortbyauthor alias for $5;
	 _pagelowerbound int;
	 _pageupperbound int;
	 _totalrows int;
	 _remainder int;
	_rec mp_modules_selectpage_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;
_pageupperbound := _pagelowerbound + _pagesize + 1;

if _sortbymoduletype = true then
for _rec in
	select 
		m.moduleid ,
		m.moduletitle ,
		md.featurename ,
		md.resourcefile,
		md.controlsrc ,
		m.authorizededitroles ,
		u.name as createdby,
		m.createddate 
		

	from 		mp_modules m
	join		mp_moduledefinitions md
	on		m.moduledefid = md.moduledefid
	left outer join mp_users u
	on	m.createdbyuserid = u.userid
	where m.siteid = $1 and md.isadmin = false
	order by 	md.featurename, m.moduletitle
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
else
	if _sortbyauthor = true then
	for _rec in
		select 
			m.moduleid ,
			m.moduletitle ,
			md.featurename ,
			md.resourcefile,
			md.controlsrc ,
			m.authorizededitroles ,
			u.name as createdby,
			m.createddate 
			
	
		from 		mp_modules m
		join		mp_moduledefinitions md
		on		m.moduledefid = md.moduledefid
		left outer join mp_users u
		on	m.createdbyuserid = u.userid
		where m.siteid = $1 and md.isadmin = false
		order by 	u.name, m.moduletitle
		limit 	_pagesize
		offset 	_pagelowerbound
	loop
		return next _rec;
	end loop;
	else
		
		for _rec in
			select 
				m.moduleid ,
				m.moduletitle ,
				md.featurename ,
				md.resourcefile,
				md.controlsrc ,
				m.authorizededitroles ,
				u.name as createdby,
				m.createddate 
				
		
			from 		mp_modules m
			join		mp_moduledefinitions md
			on		m.moduledefid = md.moduledefid
			left outer join mp_users u
			on	m.createdbyuserid = u.userid
			where m.siteid = $1 and md.isadmin = false
			order by 	m.moduletitle, md.featurename
			limit 	_pagesize
			offset 	_pagelowerbound
		loop
			return next _rec;
		end loop;
		
	end if;
end if;

return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_modules_update(integer, integer, character varying, text, integer, boolean, integer, boolean, boolean, character varying)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleid alias for $1;
	_moduledefid alias for $2;
	_moduletitle alias for $3;
	_authorizededitroles alias for $4;
	_cachetime alias for $5;
	_showtitle alias for $6;
	_edituserid alias for $7;
	_availableformypage alias for $8;
	_allowmultipleinstancesonmypage alias for $9;
	_icon alias for $10;
	_rowcount int4;
begin

update 		mp_modules 
set
			
			moduledefid = _moduledefid,
			moduletitle = _moduletitle,
			authorizededitroles = _authorizededitroles,
			cachetime = _cachetime,
			showtitle = _showtitle,
			edituserid = _edituserid,
			availableformypage = _availableformypage,
			allowmultipleinstancesonmypage = _allowmultipleinstancesonmypage,
			icon = _icon
			
where
			moduleid = _moduleid; 
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

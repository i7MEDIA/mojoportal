 RETURNS SETOF mp_commerces_totalrevenuetype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		cast(SUM(subtotal) as numeric(15,4)) As sales 
		
from 		mp_commercereport
 
where 	siteguid = $1 


; $function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_getitemsummary(character)
 RETURNS SETOF mp_commerce_itemsummarytype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		siteguid,
		moduleguid,
		itemguid,
		moduletitle,
		itemname,
		cast(SUM(subtotal) as numeric(15,4)) As revenue 
		
from 		mp_commercereport
 
where 	itemguid = $1 
GROUP BY siteguid, moduleguid, itemguid, moduletitle, itemname



; $function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_getsalesgroupedbymodule(character)
 RETURNS SETOF mp_commercesalesbymoduletype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		moduleguid,
		moduletitle,
		cast(SUM(subtotal) as numeric(15,4)) As sales ,
		cast(SUM(quantity) as int4) As units 
		
from 		mp_commercereport
 
where 	siteguid = $1 
GROUP BY moduleguid, moduletitle
ORDER BY sales DESC


; $function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_getsalesgroupedbyuser(character)
 RETURNS SETOF mp_commercesalesbyusertype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		c.userguid,
		COALESCE(u.userid, -1) As userid,
		COALESCE(u.name, 'deleted user') AS name,
		u.loginname,
		u.email,
		cast(SUM(subtotal) as numeric(15,4)) As sales 
		
from 		mp_commercereport c

LEFT OUTER JOIN mp_users u
ON	c.userguid = u.userguid
 
where 	c.siteguid = $1 

GROUP BY 
c.userguid,
u.userid,
u.name,
u.loginname,
u.email

ORDER BY sales DESC
LIMIT 20

; $function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_salesbyyearbymodule(character)
 RETURNS SETOF mp_commercesalesbyyeartype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		cast(date_part('year', orderdateutc) as int4) as y,
		cast(SUM(subtotal) as numeric(15,4)) As sales ,
		cast(SUM(quantity) as int4) As units 
		
from 		mp_commercereport
 
where 	moduleguid = $1 

group by 	date_part('year', orderdateutc)
		
order by 	y desc

; $function$
;

CREATE OR REPLACE FUNCTION public.mp_users_updatetotalarevenue()
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare

	_rowcount int;
begin


update mp_users
set totalrevenue = COALESCE((
SELECT SUM(subtotal) FROM mp_commercereport WHERE userguid = mp_users.userguid)
, 0)
;  

GET DIAGNOSTICS _rowcount = ROW_COUNT;

return _rowcount;
end$function$
;

ALTER TABLE ONLY public.mp_contentworkflowaudithistory
    ADD CONSTRAINT fk_cwaudithistory_contentworkflow FOREIGN KEY (contentworkflowguid) REFERENCES public.mp_contentworkflow(guid) ON UPDATE RESTRICT ON DELETE RESTRICT;

ALTER TABLE ONLY public.mp_letter
    ADD CONSTRAINT fk_letter_letterinfo FOREIGN KEY (letterinfoguid) REFERENCES public.mp_letterinfo(letterinfoguid);

ALTER TABLE ONLY public.mp_geozone
    ADD CONSTRAINT fk_mgeozone_geocountry FOREIGN KEY (countryguid) REFERENCES public.mp_geocountry(guid) ON UPDATE RESTRICT ON DELETE RESTRICT;

ALTER TABLE ONLY public.mp_modules
    ADD CONSTRAINT fk_modules_moduledefinitions_fk FOREIGN KEY (moduledefid) REFERENCES public.mp_moduledefinitions(moduledefid);

ALTER TABLE ONLY public.mp_modulesettings
    ADD CONSTRAINT fk_modulesettings_modules FOREIGN KEY (moduleid) REFERENCES public.mp_modules(moduleid);

ALTER TABLE ONLY public.mp_tagitem
    ADD CONSTRAINT fk_mp_tagitem_mp_tag FOREIGN KEY (tagguid) REFERENCES public.mp_tag(guid);

ALTER TABLE ONLY public.mp_pagemodules
    ADD CONSTRAINT fk_pagemodules_modules FOREIGN KEY (moduleid) REFERENCES public.mp_modules(moduleid);

ALTER TABLE ONLY public.mp_pagemodules
    ADD CONSTRAINT fk_pagemodules_pages FOREIGN KEY (pageid) REFERENCES public.mp_pages(pageid);

ALTER TABLE ONLY public.mp_pages
    ADD CONSTRAINT fk_pages_sites FOREIGN KEY (siteid) REFERENCES public.mp_sites(siteid);

ALTER TABLE ONLY public.mp_roles
    ADD CONSTRAINT fk_roles_portals_fk FOREIGN KEY (siteid) REFERENCES public.mp_sites(siteid);

ALTER TABLE ONLY public.mp_roles
    ADD CONSTRAINT fk_roles_sites FOREIGN KEY (siteid) REFERENCES public.mp_sites(siteid);

ALTER TABLE ONLY public.mp_sitemoduledefinitions
    ADD CONSTRAINT fk_sitemoduledefinitions_sites FOREIGN KEY (siteid) REFERENCES public.mp_sites(siteid);


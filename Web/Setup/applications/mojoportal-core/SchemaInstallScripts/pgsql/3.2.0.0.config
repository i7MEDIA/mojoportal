CREATE OR REPLACE FUNCTION public.mp_users_selectpage(integer, integer, character varying, integer, integer)
 RETURNS SETOF mp_users_selectpage_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_pagenumber alias for $1;
	_pagesize alias for $2;
	_usernamebeginswith alias for $3;
	_siteid alias for $4;
	_totalpages alias for $5;
	 _pagelowerbound int;
	 _pageupperbound int;
	 _totalrows int;
	 _remainder int;
	_rec mp_users_selectpage_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;
_pageupperbound := _pagelowerbound + _pagesize + 1;

for _rec in
	select 
		userid,
		siteid,
		name,
		loginname,
		email,
		loweredemail,
		password,
		passwordquestion,
		passwordanswer,
		gender,
		profileapproved,
		registerconfirmguid,
		approvedforforums,
		trusted,
		displayinmemberlist,
		websiteurl,
		country,
		state,
		occupation,
		interests,
		msn,
		yahoo,
		aim,
		icq,
		totalposts,
		avatarurl,
		timeoffsethours,
		signature,
		datecreated,
		userguid,
		skin,
		isdeleted,
		lastactivitydate,
		lastlogindate,
		lastpasswordchangeddate,
		lastlockoutdate,
		failedpasswordattemptcount,
		failedpwdattemptwindowstart,
		failedpwdanswerattemptcount,
		failedpwdanswerwindowstart,
		islockedout,
		mobilepin,
		passwordsalt,
        	comment,
		_totalpages as totalpages

	from 		mp_users 
	where 	profileapproved = true
	 and 	displayinmemberlist = true  
	 and 	siteid = _siteid
	 and 	isdeleted = false
	 and	(_usernamebeginswith is null 
		or _usernamebeginswith = ''
		or name like _usernamebeginswith)
	order by 	name
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

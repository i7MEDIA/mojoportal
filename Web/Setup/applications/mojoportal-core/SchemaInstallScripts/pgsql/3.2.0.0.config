CREATE OR REPLACE FUNCTION public.mp_commercereport_selectitempagebymodule(character, integer, integer)
 RETURNS SETOF mp_commerce_itempagetype
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_moduleguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_commerce_itempagetype%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
	moduletitle,
        itemname,
        itemguid,
        cast(SUM(quantity) as int4) As unitssold,
        cast(SUM(subtotal) as numeric(15,4)) As revenue  

	from mp_commercereport
	where moduleguid = _moduleguid
	group by moduletitle, itemname, itemguid
	order by moduletitle, itemname
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_selectuserpage(character, integer, integer)
 RETURNS SETOF mp_commerce_userpagetype
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_siteguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_commerce_userpagetype%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
	c.userguid,
	COALESCE(u.userid, -1) As userid,
	COALESCE(u.name, 'deleted user') AS name,
	u.loginname,
	u.email,
        cast(SUM(subtotal) as numeric(15,4)) As revenue  

	from mp_commercereport c
	
	LEFT OUTER JOIN mp_users u
ON	c.userguid = u.userguid
	
	where c.siteguid = _siteguid
	
	GROUP BY 
	c.userguid,
	u.userid,
	u.name,
	u.loginname,
u.email
	
	order by u.name
	
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_urlid alias for $1;
	_rowcount int4;
begin

	
	delete from mp_friendlyurls
	where urlid = _urlid;
	
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_deletebypageid(character varying)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_pageid alias for $1;
	_rowcount int4;
begin

	
	delete from mp_friendlyurls
	where realurl like _pageid
	;
	
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_exists(integer, character varying)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select	cast(count(*) as int4)
from		mp_friendlyurls
where	siteid = $1 AND friendlyurl = $2; $function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_insert(integer, character varying, character varying, boolean, character, character, character)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

insert into 	mp_friendlyurls
(				
                siteid,
                friendlyurl,
                realurl,
                ispattern,
                pageguid,
                siteguid,
                itemguid
) 
values 
(				
                $1, --:siteid
                $2, --:friendlyurl
                $3, --:realurl
                $4, --:ispattern
                $5,
                $6,
                $7
);

select cast(currval('mp_friendlyurls_urlid_seq') as int4);$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_selectbyhost(character varying)
 RETURNS SETOF mp_friendlyurls_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        urlid,
	siteid,
	friendlyurl,
	realurl,
	ispattern,
	pageguid,
	siteguid,
        itemguid
from
        mp_friendlyurls
where   siteid = coalesce(	(select siteid from mp_sitehosts where hostname = $1 limit 1),
				 (select siteid from mp_sites order by siteid limit 1)
			) ;$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_selectbysiteid(integer)
 RETURNS SETOF mp_friendlyurls_selectbyhost_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        urlid,
        siteid,
        friendlyurl,
        realurl,
        ispattern
from
        mp_friendlyurls
where   siteid = $1
order by friendlyurl;$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_selectbysiteurl(integer, character varying)
 RETURNS SETOF mp_friendlyurls_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        urlid,
	siteid,
	friendlyurl,
	realurl,
	ispattern,
	pageguid,
	siteguid,
        itemguid
from
        mp_friendlyurls
        
where   siteid = $1
	and friendlyurl = $2
;$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_selectbyurl(character varying, character varying)
 RETURNS SETOF mp_friendlyurls_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        urlid,
	siteid,
	friendlyurl,
	realurl,
	ispattern,
	pageguid,
	siteguid,
        itemguid
from
        mp_friendlyurls
        
where   friendlyurl = $2
	and siteid = coalesce(	(select siteid from mp_sitehosts where hostname = $1 limit 1),
				 (select siteid from mp_sites order by siteid limit 1)
			) ;$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_selectone(integer)
 RETURNS SETOF mp_friendlyurls_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        urlid,
	siteid,
	friendlyurl,
	realurl,
	ispattern,
	pageguid,
	siteguid,
        itemguid
from
        mp_friendlyurls
        
where
        urlid = $1;$function$
;
CREATE OR REPLACE FUNCTION public.mp_friendlyurls_update(integer, integer, character varying, character varying, boolean, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_urlid alias for $1;
	_siteid alias for $2;
	_friendlyurl alias for $3;
	_realurl alias for $4;
	_ispattern alias for $5;
	_pageguid alias for $6;
	_rowcount int4;
begin

update 		mp_friendlyurls

set
            siteid = _siteid, --:siteid
            friendlyurl = _friendlyurl, --:friendlyurl
            realurl = _realurl, --:realurl
            ispattern = _ispattern, --:ispattern,
            pageguid = _pageguid
            
where
            urlid = _urlid; --:urlid

GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

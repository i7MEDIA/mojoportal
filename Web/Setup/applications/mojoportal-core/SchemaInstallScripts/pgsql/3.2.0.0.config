    r.siteid,
    r.roleid,
    r.rolename,
    r.displayname
    
from
    mp_roles r
    
left outer join 
    mp_userroles  ur
    
on ur.roleid = r.roleid
and ur.userid = $2

where   
    r.siteid = $1
    and ur.userid is null
order by r.displayname
    ; $function$
;

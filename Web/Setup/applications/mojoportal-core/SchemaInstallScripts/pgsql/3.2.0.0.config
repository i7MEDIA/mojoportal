;
CREATE OR REPLACE FUNCTION public.mp_letter_update(character, character, character varying, text, text, character, timestamp without time zone, boolean, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$

declare
            _letterguid alias for $1;
            _letterinfoguid alias for $2;
            _subject alias for $3;
            _htmlbody alias for $4;
            _textbody alias for $5;
            _lastmodby alias for $6;
            _lastmodutc alias for $7;
            _isapproved alias for $8;
            _approvedby alias for $9;
           
			_rowcount int4;
begin
update 		mp_letter

set
            letterinfoguid = _letterinfoguid, 
            subject = _subject, 
            htmlbody = _htmlbody, 
            textbody = _textbody,  
            lastmodby = _lastmodby, 
            lastmodutc = _lastmodutc, 
            isapproved = _isapproved, 
            approvedby = _approvedby
            
            
where
            letterguid = _letterguid; 
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

CREATE OR REPLACE FUNCTION public.monthname(timestamp with time zone)
 RETURNS character varying
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_date alias for $1;
	_month int;
	_monthname varchar(10);
begin
    _month := date_part('month', _date);
    _monthname := 'January';
    if _month = 2 then
        _monthname := 'February';
    end if;
    if _month = 3 then
        _monthname := 'March';
    end if;
    if _month = 4 then
        _monthname := 'April';
    end if;
    if _month = 5 then
        _monthname := 'May';
    end if;
    if _month = 6 then
        _monthname := 'June';
    end if;
    if _month = 7 then
        _monthname := 'July';
    end if;
    if _month = 8 then
        _monthname := 'August';
    end if;
    if _month = 9 then
        _monthname := 'September';
    end if;
    if _month = 10 then
        _monthname := 'October';
    end if;
    if _month = 11 then
        _monthname := 'November';
    end if;
    if _month = 12 then
        _monthname := 'December';
    end if;
    return _monthname;    
end;$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_count()
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  	cast(count(*) as int4)
from		mp_bannedipaddresses
; $function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_delete(integer)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
            _rowid alias for $1;
			_rowcount int4;
begin
	delete from mp_bannedipaddresses
	where rowid = _rowid;
	
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_insert(character varying, timestamp without time zone, character varying)
 RETURNS integer
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

insert into 	mp_bannedipaddresses
(				
                bannedip,
                bannedutc,
                bannedreason
) 
values 
(				
                $1, --:bannedip
                $2, --:bannedutc
                $3 --:bannedreason
);
select cast(currval('mp_bannedipaddressesid_seq') as int4);$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_select_all()
 RETURNS SETOF mp_bannedipaddresses_select_all_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        rowid,
        bannedip,
        bannedutc,
        bannedreason
from
        mp_bannedipaddresses
;$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_select_one(integer)
 RETURNS SETOF mp_bannedipaddresses_select_one_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$

select
        rowid,
        bannedip,
        bannedutc,
        bannedreason
from
        mp_bannedipaddresses
        
where
        rowid = $1;$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_selectpage(integer, integer)
 RETURNS SETOF mp_bannedipaddresses_select_all_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_pagenumber alias for $1;
	_pagesize alias for $2;
	_pagelowerbound int;
	_rec mp_bannedipaddresses_select_all_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
        rowid,
        bannedip,
        bannedutc,
        bannedreason

	from mp_bannedipaddresses
	order by bannedip
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_bannedipaddresses_update(integer, character varying, timestamp without time zone, character varying)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$

declare
            _rowid alias for $1;
            _bannedip alias for $2;
            _bannedutc alias for $3;
            _bannedreason alias for $4;
			_rowcount int4;
begin
update 		mp_bannedipaddresses

set
            bannedip = _bannedip, 
            bannedutc = _bannedutc, 
            bannedreason = _bannedreason 
            
where
            rowid = _rowid; 
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_alltimerevenuebyitem(character)
 RETURNS SETOF mp_commerces_totalrevenuetype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		cast(SUM(subtotal) as numeric(15,4)) As sales 
		
from 		mp_commercereport
 
where 	itemguid = $1 


; $function$
;
CREATE OR REPLACE FUNCTION public.mp_commercereport_alltimerevenuebymodule(character)
 RETURNS SETOF mp_commerces_totalrevenuetype
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select 	
		cast(SUM(subtotal) as numeric(15,4)) As sales 
		
from 		mp_commercereport
 
where 	moduleguid = $1 


; $function$
;

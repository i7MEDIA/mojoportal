CREATE OR REPLACE FUNCTION public.mp_lettersendlog_selectpage(character, integer, integer)
 RETURNS SETOF mp_lettersendlog_select_one_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_letterguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_lettersendlog_select_one_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
        rowid,
        letterguid,
        userguid,
        emailaddress,
        utc,
        erroroccurred,
        errormessage

	from mp_lettersendlog
	where letterguid = _letterguid
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

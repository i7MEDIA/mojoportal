CREATE OR REPLACE FUNCTION public.mp_taskqueue_selectpage(integer, integer)
 RETURNS SETOF mp_taskqueue_select_one_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_pagenumber alias for $1;
	_pagesize alias for $2;
	_pagelowerbound int;
	_rec mp_taskqueue_select_one_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
        guid,
        siteguid,
        queuedby,
        taskname,
        notifyoncompletion,
        notificationtoemail,
        notificationfromemail,
        notificationsubject,
        taskcompletemessage,
        notificationsentutc,
        canstop,
        canresume,
        updatefrequency,
        queuedutc,
        startutc,
        completeutc,
        laststatusupdateutc,
        completeratio,
        status,
        serializedtaskobject,
        serializedtasktype

	from mp_taskqueue
	order by queuedutc	
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

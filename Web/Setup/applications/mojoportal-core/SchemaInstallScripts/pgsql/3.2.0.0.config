CREATE OR REPLACE FUNCTION public.mp_userroles_insert(integer, integer, character, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_roleid alias for $1;
	_userid alias for $2;
	_roleguid alias for $3;
	_userguid alias for $4;
	t_found int4;
	_rowcount int4;

begin

_rowcount := 0;
select into t_found 1 from
    mp_userroles
	where
	    userid=_userid
	    and
	    roleid=_roleid limit 1;

if not found then

    insert into mp_userroles
    (
        userid,
        roleid,
        roleguid,
        userguid
    )
    values
    (
        _userid,
        _roleid,
        _roleguid,
        _userguid
    );   
	GET DIAGNOSTICS _rowcount = ROW_COUNT;
end if;
return _rowcount;
end$function$
;
CREATE OR REPLACE FUNCTION public.mp_userroles_selectbyroleid(integer)
 RETURNS SETOF mp_userroles_selectbyroleid_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  
    mp_userroles.userid,
    name,
    email
from
    mp_userroles
    
inner join 
    mp_users on mp_users.userid = mp_userroles.userid
where   
    mp_userroles.roleid = $1; $function$
;
CREATE OR REPLACE FUNCTION public.mp_userroles_selectnotinrole(integer, integer)
 RETURNS SETOF mp_userroles_selectbyroleid_type
 LANGUAGE sql
 SECURITY DEFINER
AS $function$
select  
    u.userid,
    u.name,
    u.email
from
    mp_users u 
    
left outer join 
    mp_userroles  ur
    
on ur.userid = u.userid
and ur.roleid = $2

where   
    u.siteid = $1
    and ur.roleid is null
order by u.name
    ; $function$
;

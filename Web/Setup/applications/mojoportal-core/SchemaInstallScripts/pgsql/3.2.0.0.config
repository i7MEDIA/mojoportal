CREATE OR REPLACE FUNCTION public.mp_letterhtmltemplate_selectpage(character, integer, integer)
 RETURNS SETOF mp_letterhtmltemplate_select_one_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_siteguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_letterhtmltemplate_select_one_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
        guid,
        siteguid,
        title,
        html,
        lastmodutc

	from mp_letterhtmltemplate
	where siteguid = _siteguid
	order by title
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

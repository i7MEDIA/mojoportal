CREATE OR REPLACE FUNCTION public.mp_letter_selectdraftspage(character, integer, integer)
 RETURNS SETOF mp_letter_select_one_type
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
	_letterinfoguid alias for $1;
	_pagenumber alias for $2;
	_pagesize alias for $3;
	_pagelowerbound int;
	_rec mp_letter_select_one_type%ROWTYPE;

begin

_pagelowerbound := (_pagesize * _pagenumber) - _pagesize;

for _rec in
	select 
        letterguid,
        letterinfoguid,
        subject,
        htmlbody,
        textbody,
        createdby,
        createdutc,
        lastmodby,
        lastmodutc,
        isapproved,
        approvedby,
        sendclickedutc,
        sendstartedutc,
        sendcompleteutc,
        sendcount

	from mp_letter
	where letterinfoguid = _letterinfoguid
		and sendclickedutc is  null
	order by sendclickedutc desc	
	limit 	_pagesize
	offset 	_pagelowerbound
loop
	return next _rec;
end loop;
return;
end$function$
;

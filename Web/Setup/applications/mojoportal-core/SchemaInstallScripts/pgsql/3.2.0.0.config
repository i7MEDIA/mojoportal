CREATE OR REPLACE FUNCTION public.mp_letter_insert(character, character, character varying, text, text, character, timestamp without time zone, character, timestamp without time zone, boolean, character)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
declare
            _letterguid alias for $1;
            _letterinfoguid alias for $2;
            _subject alias for $3;
            _htmlbody alias for $4;
            _textbody alias for $5;
            _createdby alias for $6;
            _createdutc alias for $7;
            _lastmodby alias for $8;
            _lastmodutc alias for $9;
            _isapproved alias for $10;
            _approvedby alias for $11;
           
			_rowcount int4;
begin

insert into 	mp_letter
(			
                letterguid,
                letterinfoguid,
                subject,
                htmlbody,
                textbody,
                createdby,
                createdutc,
                lastmodby,
                lastmodutc,
                isapproved,
                approvedby,
                sendcount
) 
values 
(				
                _letterguid, 
                _letterinfoguid, 
                _subject, 
                _htmlbody, 
                _textbody, 
                _createdby, 
                _createdutc, 
                _lastmodby, 
                _lastmodutc, 
                _isapproved, 
                _approvedby, 
                0 
);
GET DIAGNOSTICS _rowcount = ROW_COUNT;
return _rowcount;
end$function$
;

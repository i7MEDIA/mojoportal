<?xml version="1.0" encoding="utf-8" ?>
<ExternalNewsletterProviders>
	<providers>
		<add name="SendGridNewsletterProvider"
			 type="mojoPortal.Web.ExternalNewsletter.SendGridNewsletterProvider, mojoPortal.Web"
			 description="SendGrid Marketing Campaigns Newsletter Provider"
			 apiKey=""
			 defaultOptIn="false">
			<lists>
				<!-- Optional explicitly configured lists. If empty and apiKey is provided, active lists are auto-discovered from SendGrid.
				<list id="e388dc08-1111-2222-3333-444455556666"
					  title="Product News &amp; Updates"
					  description="Stay informed about our latest products and feature announcements."
					  profileOptIn="true"
					  sortRank="100" />
				-->
			</lists>
		</add>
	</providers>
</ExternalNewsletterProviders>
